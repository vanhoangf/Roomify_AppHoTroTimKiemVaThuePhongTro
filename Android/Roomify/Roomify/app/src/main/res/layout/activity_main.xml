<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <!-- BRAND -->
        <ImageView
            android:id="@+id/tvLogo"
            android:layout_width="match_parent"
            android:layout_height="144dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/roomify_logo_name"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:contentDescription="Logo Roomify" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Tìm phòng trọ phù hợp với bạn"
            android:textSize="14sp"
            android:fontFamily="@font/plus_jakarta_sans"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="8dp" />

        <!-- WELCOME -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="Chào mừng bạn đến với Roomify"
            style="@style/TextAppearance.Roomify.Large" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Đăng nhập để bắt đầu tìm kiếm phòng trọ an toàn, giá tốt."
            style="@style/TextAppearance.Roomify.Body" />

        <!-- EMAIL LABEL -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Email"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/plus_jakarta_sans"
            android:textSize="14sp" />

        <!-- EMAIL INPUT -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilLoginEmail"
            style="@style/Widget.Roomify.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:hintEnabled="false"
            app:boxBackgroundMode="outline">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:hint="Nhập email của bạn"
                android:inputType="textEmailAddress"
                android:autofillHints="emailAddress"
                android:fontFamily="@font/plus_jakarta_sans"
                android:singleLine="true" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- PASSWORD LABEL -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Mật khẩu"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/plus_jakarta_sans"
            android:textSize="14sp" />

        <!-- PASSWORD INPUT -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilLoginPassword"
            style="@style/Widget.Roomify.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:hintEnabled="false"
            app:boxBackgroundMode="outline"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:paddingStart="16dp"
                android:hint="Nhập mật khẩu"
                android:inputType="textPassword"
                android:autofillHints="password"
                android:fontFamily="@font/plus_jakarta_sans"
                android:singleLine="true" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- FORGOT PASSWORD -->
        <TextView
            android:id="@+id/tvForgotPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:text="Quên mật khẩu? (Chưa hỗ trợ)"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:fontFamily="@font/plus_jakarta_sans"
            android:visibility="gone"/>

        <!-- LOGIN BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            style="@style/Widget.Roomify.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Đăng nhập" />

        <!-- LOGIN STATUS -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text=""
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- GOOGLE - NOT SUPPORTED YET -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoogle"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="56dp"
            android:enabled="false"
            android:text="Google (Chưa hỗ trợ)"
            android:textAllCaps="false"
            android:visibility="gone"/>

        <!-- REGISTER LINK - NEXT STEP -->
        <TextView
            android:id="@+id/tvRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="Chưa có tài khoản? Đăng ký"
            android:textColor="@color/primary_blue"
            android:textSize="14sp"
            android:fontFamily="@font/plus_jakarta_sans" />

        <!-- EXISTING DEBUG CONTROLS -->
        <!-- Keep these IDs for existing MainActivity code. -->

        <Button
            android:id="@+id/btnSession"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="Kiểm tra Session" />

        <Button
            android:id="@+id/btnMe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="Kiểm tra /auth/me" />

        <TextView
            android:id="@+id/tvUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>
