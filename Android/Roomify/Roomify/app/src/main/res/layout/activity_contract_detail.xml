<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/contractDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg"
    android:orientation="vertical">

    <!-- ===================================================== -->
    <!-- HEADER -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/surface_white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Quay lại"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            style="@style/TextAppearance.Roomify.Section"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Chi tiết hợp đồng"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />

        <Space
            android:layout_width="48dp"
            android:layout_height="1dp" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- CONTENT -->
    <!-- ===================================================== -->

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="32dp">


                <!-- ================================================= -->
                <!-- CONTRACT HEADER CARD -->
                <!-- ================================================= -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/surface_white"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/stroke_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <!-- CODE + STATUS -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/TextAppearance.Roomify.Caption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="MÃ HỢP ĐỒNG"
                                    android:textColor="@color/text_muted" />

                                <TextView
                                    android:id="@+id/tvContractCode"
                                    style="@style/TextAppearance.Roomify.CardTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:text="HD-DEMO-0001"
                                    android:textColor="@color/text_primary" />

                            </LinearLayout>

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Đang hiệu lực"
                                android:textSize="11sp"
                                app:chipBackgroundColor="@color/chip_bg"
                                app:ensureMinTouchTargetSize="false" />

                        </LinearLayout>


                        <!-- ROOM -->
                        <TextView
                            android:id="@+id/tvRoomTitle"
                            style="@style/TextAppearance.Roomify.Large"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="Phòng Roomify Demo 01"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/tvPropertyName"
                            style="@style/TextAppearance.Roomify.Secondary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Khu trọ Roomify Demo 01" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- ================================================= -->
                <!-- CONTRACT INFORMATION -->
                <!-- ================================================= -->

                <TextView
                    style="@style/TextAppearance.Roomify.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:text="Thông tin hợp đồng"
                    android:textColor="@color/text_primary" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@color/surface_white"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/stroke_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            style="@style/TextAppearance.Roomify.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="CHI TIẾT"
                            android:textColor="@color/text_muted" />

                        <TextView
                            android:id="@+id/tvContractInfo"
                            style="@style/TextAppearance.Roomify.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:lineSpacingExtra="5dp"
                            android:textColor="@color/text_primary" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- ================================================= -->
                <!-- TERMS -->
                <!-- ================================================= -->

                <TextView
                    style="@style/TextAppearance.Roomify.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:text="Điều khoản"
                    android:textColor="@color/text_primary" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@color/surface_white"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/stroke_border"
                    app:strokeWidth="1dp">

                    <TextView
                        android:id="@+id/tvTerms"
                        style="@style/TextAppearance.Roomify.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="3dp"
                        android:padding="18dp"
                        android:text="Chưa có điều khoản bổ sung."
                        android:textColor="@color/text_secondary" />

                </com.google.android.material.card.MaterialCardView>


                <!-- ================================================= -->
                <!-- DOCUMENTS & SERVICES -->
                <!-- ================================================= -->

                <TextView
                    style="@style/TextAppearance.Roomify.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:text="Tài liệu &amp; dịch vụ"
                    android:textColor="@color/text_primary" />

                <TextView
                    style="@style/TextAppearance.Roomify.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Quản lý hợp đồng, thanh toán và trải nghiệm thuê phòng." />


                <!-- FILE + PAYMENT -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <!-- CONTRACT FILE -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnContractFile"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="Xem hợp đồng"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        app:cornerRadius="14dp" />

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="1dp" />

                    <!-- PAYMENTS -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPayments"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="Thanh toán"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        app:cornerRadius="14dp" />

                </LinearLayout>


                <!-- REVIEW -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="@color/surface_light"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            style="@style/TextAppearance.Roomify.CardTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Trải nghiệm thuê phòng"
                            android:textColor="@color/text_primary" />

                        <TextView
                            style="@style/TextAppearance.Roomify.Secondary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Chia sẻ đánh giá của bạn để giúp những sinh viên khác tham khảo." />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnReview"
                            style="@style/Widget.Roomify.Button.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="12dp"
                            android:text="★  Đánh giá phòng"
                            android:textAllCaps="false"
                            android:visibility="gone"
                            app:cornerRadius="14dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- INFO -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardBackgroundColor="@color/surface_light"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp">

                    <TextView
                        style="@style/TextAppearance.Roomify.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="2dp"
                        android:padding="14dp"
                        android:text="Bạn có thể xem thông tin thanh toán và đánh giá phòng trong thời gian hợp đồng đang hoạt động hoặc sau khi hoàn thành." />

                </com.google.android.material.card.MaterialCardView>


                <Space
                    android:layout_width="match_parent"
                    android:layout_height="12dp" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>


        <!-- ================================================= -->
        <!-- LOADING -->
        <!-- ================================================= -->

        <ProgressBar
            android:id="@+id/progressDetail"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center" />

    </FrameLayout>


    <!-- ===================================================== -->
    <!-- CONTRACT ACTIONS -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/actionContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_white"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <!-- CANCEL -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:text="Hủy hợp đồng"
            android:textAllCaps="false"
            android:textColor="@color/status_error"
            app:cornerRadius="14dp" />

        <!-- ACTIVATE -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnActivate"
            style="@style/Widget.Roomify.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Kích hoạt"
            android:textAllCaps="false"
            app:cornerRadius="14dp" />

    </LinearLayout>

</LinearLayout>