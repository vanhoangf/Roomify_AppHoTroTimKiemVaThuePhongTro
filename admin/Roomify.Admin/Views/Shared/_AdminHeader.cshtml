@using System.Security.Claims

@{
    var displayName =
        User.Identity?.Name
        ?? "Quản trị viên";

    var email =
        User.FindFirst(
            ClaimTypes.Email
        )?.Value
        ?? string.Empty;

    var firstLetter =
        !string.IsNullOrWhiteSpace(displayName)
            ? displayName.Substring(0, 1).ToUpper()
            : "A";
}

<header class="admin-header">

    <!-- =========================
         SEARCH
         ========================= -->
    <div class="header-search">

        <svg viewBox="0 0 24 24"
             aria-hidden="true">
            <path d="M10.5 4a6.5 6.5 0 1 0 4.1 11.5L20 20.9 21.4 19.5 16 14.1A6.5 6.5 0 0 0 10.5 4Zm0 2a4.5 4.5 0 1 1 0 9 4.5 4.5 0 0 1 0-9Z" />
        </svg>

        <input type="text"
               placeholder="Tìm kiếm người dùng, phòng trọ, mã tin..."
               disabled />

    </div>


    <!-- =========================
         RIGHT
         ========================= -->
    <div class="admin-header-actions">

        <!-- Notification -->
        <button type="button"
                class="header-action-button"
                title="Thông báo">

            <svg viewBox="0 0 24 24"
                 aria-hidden="true">
                <path d="M12 22a2.5 2.5 0 0 0 2.3-1.5H9.7A2.5 2.5 0 0 0 12 22Zm7-6v-5a7 7 0 0 0-6-6.9V3h-2v1.1A7 7 0 0 0 5 11v5l-2 2v1h18v-1l-2-2Zm-12 1v-6a5 5 0 0 1 10 0v6H7Z" />
            </svg>

            <span class="notification-badge">
                3
            </span>

        </button>


        <!-- Help -->
        <button type="button"
                class="header-action-button"
                title="Trợ giúp">

            <svg viewBox="0 0 24 24"
                 aria-hidden="true">
                <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm0 18a8 8 0 1 1 0-16 8 8 0 0 1 0 16Zm-.1-5.1h2v2h-2v-2Zm.1-8.8c2.1 0 3.5 1.2 3.5 3 0 1.3-.7 2-1.7 2.7-.8.5-1.1.9-1.1 1.8h-1.9c0-1.5.5-2.3 1.7-3.1.7-.5 1.1-.8 1.1-1.5 0-.8-.6-1.3-1.6-1.3-.9 0-1.6.5-2.2 1.3L8.4 7.8c.9-1.2 2-1.7 3.6-1.7Z" />
            </svg>

        </button>


        <div class="header-divider"></div>


        <!-- Account -->
        <div class="dropdown">

            <button type="button"
                    class="admin-account"
                    data-bs-toggle="dropdown"
                    aria-expanded="false">

                <div class="admin-avatar">
                    @firstLetter
                </div>

                <div class="admin-account-info">

                    <strong>
                        @displayName
                    </strong>

                    <span>
                        Quản trị viên cấp cao
                    </span>

                </div>

                <svg class="account-chevron"
                     viewBox="0 0 24 24">

                    <path d="m7 10 5 5 5-5H7Z" />

                </svg>

            </button>


            <div class="dropdown-menu dropdown-menu-end admin-user-menu">

                <div class="dropdown-user-summary">

                    <strong>
                        @displayName
                    </strong>

                    <span>
                        @email
                    </span>

                </div>

                <div class="dropdown-divider"></div>

                <form asp-controller="Auth"
                      asp-action="Logout"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="dropdown-item logout-item">

                        <svg viewBox="0 0 24 24">
                            <path d="M10 4H5v16h5v-2H7V6h3V4Zm7.6 3.6L16.2 9l2 2H10v2h8.2l-2 2 1.4 1.4L22 12l-4.4-4.4Z" />
                        </svg>

                        Đăng xuất

                    </button>

                </form>

            </div>

        </div>

    </div>

</header>