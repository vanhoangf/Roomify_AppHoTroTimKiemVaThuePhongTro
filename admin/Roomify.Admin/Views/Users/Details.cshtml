                            <div class="modal-footer">

                                <button type="button"
                                        class="modal-cancel-button"
                                        data-bs-dismiss="modal">

                                    Hủy

                                </button>


                                <button type="submit"
                                        class="modal-success-button">

                                    Xác nhận xác minh

                                </button>

                            </div>

                        </form>

                    </div>

                </div>

            </div>
        }
    }

</div>


@section Scripts {

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function() {

                const form =
                    document.getElementById(
                        "lockUserForm"
                    );

                const reason =
                    document.getElementById(
                        "lockReason"
                    );

                const error =
                    document.getElementById(
                        "lockReasonError"
                    );


                // Trang lỗi, tài khoản hiện tại hoặc
                // user đang bị khóa sẽ không có form lock.
                if (!form ||
                    !reason ||
                    !error) {

                    return;
                }


                form.addEventListener(
                    "submit",
                    function(event) {

                        const reasonValue =
                            reason.value.trim();


                        if (reasonValue.length === 0) {

                            event.preventDefault();

                            error.hidden = false;

                            reason.classList.add(
                                "is-invalid-field"
                            );

                            reason.focus();

                            return;
                        }


                        error.hidden = true;

                        reason.classList.remove(
                            "is-invalid-field"
                        );

                    });


                reason.addEventListener(
                    "input",
                    function() {

                        if (
                            reason.value.trim()
                                .length > 0
                        ) {
                            error.hidden = true;

                            reason.classList.remove(
                                "is-invalid-field"
                            );
                        }

                    });


                reason.addEventListener(
                    "blur",
                    function() {

                        if (
                            reason.value.trim()
                                .length === 0
                        ) {
                            error.hidden = false;

                            reason.classList.add(
                                "is-invalid-field"
                            );
                        }

                    });

            });

    </script>

}