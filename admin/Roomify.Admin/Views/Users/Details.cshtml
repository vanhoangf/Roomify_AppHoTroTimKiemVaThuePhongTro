@model Roomify.Admin.Models.Users.AdminUserDetailViewModel

@{
    ViewData["Title"] = "Chi tiết người dùng";

    var user = Model.User;

    var currentAdminIdText =
        User.FindFirst(
            System.Security.Claims.ClaimTypes.NameIdentifier
        )?.Value;

    var isCurrentAdmin = false;

    if (user is not null &&
        long.TryParse(
            currentAdminIdText,
            out var currentAdminId))
    {
        isCurrentAdmin =
            currentAdminId == user.UserId;
    }

    string Initials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
        {
            return "?";
        }

        var parts =
            fullName.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length == 1)
        {
            return parts[0][0]
                .ToString()
                .ToUpper();
        }

        return string.Concat(
                parts[^2][0],
                parts[^1][0])
            .ToUpper();
    }
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/admin-user-detail.css"
          asp-append-version="true" />
}


<div class="user-detail-page">

    <!-- =====================================================
         ERROR
         ===================================================== -->
    @if (Model.HasError || user is null)
    {
        <section class="user-detail-error">

            <div class="detail-error-icon">
                !
            </div>

            <h1>
                Không thể tải người dùng
            </h1>

            <p>
                @Model.ErrorMessage
            </p>

            <a href="@(Model.ReturnUrl ?? Url.Action("Index", "Users"))"
               class="detail-primary-link">

                Quay lại danh sách

            </a>

        </section>
    }
    else
    {
        <!-- =================================================
             BREADCRUMB
             ================================================= -->

        <div class="detail-breadcrumb">

            <a asp-controller="Dashboard"
               asp-action="Index">
                Trang chủ
            </a>

            <span>›</span>

            <a href="@(Model.ReturnUrl ?? Url.Action("Index", "Users"))">
                Người dùng
            </a>

            <span>›</span>

            <strong>
                Chi tiết người dùng
            </strong>

        </div>


        <!-- =================================================
             HEADING
             ================================================= -->

        <section class="detail-heading">

            <div>

                <h1>
                    Chi tiết người dùng
                </h1>

                <p>
                    Xem thông tin tài khoản và hồ sơ người dùng Roomify.
                </p>

            </div>


            <a href="@(Model.ReturnUrl ?? Url.Action("Index", "Users"))"
               class="detail-back-button">

                <svg viewBox="0 0 24 24">
                    <path d="m15 18-6-6 6-6 1.4 1.4L11.8 12l4.6 4.6L15 18Z" />
                </svg>

                Quay lại

            </a>

        </section>


        <!-- =================================================
             SUCCESS / ERROR MESSAGE
             ================================================= -->
        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="detail-alert success">

                <span class="detail-alert-icon">
                    ✓
                </span>

                <span>
                    @successMessage
                </span>

            </div>
        }

        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="detail-alert error">

                <span class="detail-alert-icon">
                    !
                </span>

                <span>
                    @errorMessage
                </span>

            </div>
        }


        <!-- =================================================
             PROFILE SUMMARY
             ================================================= -->

        <section class="detail-profile-card">

            <div class="detail-avatar">

                @if (!string.IsNullOrWhiteSpace(user.AvatarUrl))
                {
                    <img src="@user.AvatarUrl"
                         alt="@user.FullName" />
                }
                else
                {
                    @Initials(user.FullName)
                }

            </div>


            <div class="detail-profile-main">

                <div class="detail-name-row">

                    <h2>
                        @user.FullName
                    </h2>


                    <span class="
                        detail-role
                        detail-role-@user.RoleCode.ToLowerInvariant()">

                        @(
                            user.RoleCode switch
                            {
                                "STUDENT" => "Student",
                                "LANDLORD" => "Landlord",
                                "ADMIN" => "Admin",
                                _ => user.RoleName
                            }
                        )

                    </span>


                    @if (user.Status == "ACTIVE")
                    {
                        <span class="detail-status active">

                            <i></i>

                            Hoạt động

                        </span>
                    }
                    else
                    {
                        <span class="detail-status locked">

                            <i></i>

                            Đã khóa

                        </span>
                    }

                </div>


                <span class="detail-profile-email">
                    @user.Email
                </span>


                <div class="detail-profile-meta">

                    <span>
                        User ID:
                        <strong>#@user.UserId</strong>
                    </span>

                    <span class="detail-meta-divider"></span>

                    <span>
                        Tham gia:

                        <strong>
                            @(user.CreatedAt
                                .ToLocalTime()
                                .ToString("dd/MM/yyyy"))
                        </strong>

                    </span>

                </div>

            </div>

        </section>


        <!-- =================================================
             INFORMATION GRID
             ================================================= -->

        <div class="detail-grid">

            <!-- =================================================
                 ACCOUNT
                 ================================================= -->

            <section class="detail-card">

                <div class="detail-card-heading">

                    <div class="detail-card-icon blue">

                        <svg viewBox="0 0 24 24">
                            <path d="M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10Zm0-8a3 3 0 1 1 0 6 3 3 0 0 1 0-6Zm0 10c-5 0-9 2.5-9 6v2h18v-2c0-3.5-4-6-9-6Zm-7 6c.3-2 3.1-4 7-4s6.7 2 7 4H5Z" />
                        </svg>

                    </div>

                    <div>

                        <h2>
                            Thông tin tài khoản
                        </h2>

                        <p>
                            Thông tin cơ bản của người dùng
                        </p>

                    </div>

                </div>


                <div class="detail-info-list">

                    <div class="detail-info-row">

                        <span>
                            Họ và tên
                        </span>

                        <strong>
                            @user.FullName
                        </strong>

                    </div>


                    <div class="detail-info-row">

                        <span>
                            Email
                        </span>

                        <strong>
                            @user.Email
                        </strong>

                    </div>


                    <div class="detail-info-row">

                        <span>
                            Số điện thoại
                        </span>

                        <strong>
                            @(
                                string.IsNullOrWhiteSpace(
                                    user.Phone)
                                    ? "Chưa cập nhật"
                                    : user.Phone
                            )
                        </strong>

                    </div>


                    <div class="detail-info-row">

                        <span>
                            Xác minh Email
                        </span>

                        @if (user.EmailVerified)
                        {
                            <strong class="text-success-detail">
                                ✓ Đã xác minh
                            </strong>
                        }
                        else
                        {
                            <strong class="text-warning-detail">
                                Chưa xác minh
                            </strong>
                        }

                    </div>


                    <div class="detail-info-row">

                        <span>
                            Đăng nhập gần nhất
                        </span>

                        <strong>
                            @(
                                user.LastLoginAt.HasValue
                                    ? user.LastLoginAt.Value
                                        .ToLocalTime()
                                        .ToString("dd/MM/yyyy HH:mm")
                                    : "Chưa có"
                            )
                        </strong>

                    </div>


                    <div class="detail-info-row">

                        <span>
                            Ngày cập nhật
                        </span>

                        <strong>
                            @(user.UpdatedAt
                                .ToLocalTime()
                                .ToString("dd/MM/yyyy HH:mm"))
                        </strong>

                    </div>

                </div>

            </section>


            <!-- =================================================
                 PROFILE
                 ================================================= -->

            <section class="detail-card">

                <div class="detail-card-heading">

                    <div class="detail-card-icon teal">

                        <svg viewBox="0 0 24 24">
                            <path d="M4 3h16v18H4V3Zm2 2v14h12V5H6Zm2 2h8v2H8V7Zm0 4h8v2H8v-2Zm0 4h5v2H8v-2Z" />
                        </svg>

                    </div>

                    <div>

                        <h2>
                            Hồ sơ
                        </h2>

                        <p>
                            Thông tin theo vai trò người dùng
                        </p>

                    </div>

                </div>


                @if (Model.IsStudent)
                {
                    <div class="detail-info-list">

                        <div class="detail-info-row">

                            <span>
                                Student ID
                            </span>

                            <strong>
                                #@user.StudentId
                            </strong>

                        </div>


                        <div class="detail-info-row">

                            <span>
                                Trường đại học
                            </span>

                            <strong>
                                @(
                                    user.UniversityName
                                    ?? "Chưa cập nhật"
                                )
                            </strong>

                        </div>


                        <div class="detail-info-row">

                            <span>
                                Mã sinh viên
                            </span>

                            <strong>
                                @(
                                    user.StudentCode
                                    ?? "Chưa cập nhật"
                                )
                            </strong>

                        </div>


                        <div class="detail-info-row">

                            <span>
                                Thẻ sinh viên
                            </span>

                            @if (!string.IsNullOrWhiteSpace(
                                user.StudentCardUrl))
                            {
                                <a href="@user.StudentCardUrl"
                                   target="_blank"
                                   rel="noopener"
                                   class="document-link">

                                    Xem tài liệu ↗

                                </a>
                            }
                            else
                            {
                                <strong>
                                    Chưa cập nhật
                                </strong>
                            }

                        </div>

                    </div>
                }
                else if (Model.IsLandlord)
                {
                    <div class="detail-info-list">

                        <div class="detail-info-row">

                            <span>
                                Landlord ID
                            </span>

                            <strong>
                                #@user.LandlordId
                            </strong>

                        </div>


                        <div class="detail-info-row">

                            <span>
                                Số giấy tờ
                            </span>

                            <strong>
                                @(
                                    user.IdentityNumber
                                    ?? "Chưa cập nhật"
                                )
                            </strong>

                        </div>


                        <div class="detail-info-row">

                            <span>
                                Giấy tờ định danh
                            </span>

                            @if (!string.IsNullOrWhiteSpace(
                                user.IdentityDocumentUrl))
                            {
                                <a href="@user.IdentityDocumentUrl"
                                   target="_blank"
                                   rel="noopener"
                                   class="document-link">

                                    Xem tài liệu ↗

                                </a>
                            }
                            else
                            {
                                <strong>
                                    Chưa cập nhật
                                </strong>
                            }

                        </div>

                    </div>
                }
                else
                {
                    <div class="detail-admin-notice">

                        <div>
                            ADMIN
                        </div>

                        <p>
                            Tài khoản quản trị không sử dụng
                            Student Profile hoặc Landlord Profile.
                        </p>

                    </div>
                }

            </section>


            <!-- =================================================
                 VERIFICATION
                 ================================================= -->

            <section class="detail-card">

                <div class="detail-card-heading">

                    <div class="detail-card-icon green">

                        <svg viewBox="0 0 24 24">
                            <path d="m9 16.2-3.5-3.5L4.1 14.1 9 19l11-11-1.4-1.4L9 16.2Z" />
                        </svg>

                    </div>

                    <div>

                        <h2>
                            Xác minh hồ sơ
                        </h2>

                        <p>
                            Trạng thái kiểm duyệt hồ sơ
                        </p>

                    </div>

                </div>


                @if (Model.IsAdmin)
                {
                    <div class="verification-empty">

                        Không áp dụng cho tài khoản Admin.

                    </div>
                }
                else
                {
                    <div class="verification-summary">

                        @if (user.IsProfileVerified == true)
                        {
                            <div class="verification-icon verified">
                                ✓
                            </div>

                            <h3>
                                Hồ sơ đã xác minh
                            </h3>

                            <p>
                                Người dùng đã hoàn tất quá trình
                                xác minh hồ sơ.
                            </p>
                        }
                        else
                        {
                            <div class="verification-icon pending">
                                !
                            </div>

                            <h3>
                                Chưa xác minh
                            </h3>

                            <p>
                                Hồ sơ hiện chưa được Admin xác minh.
                            </p>
                        }

                    </div>


                    @if (user.IsProfileVerified == true)
                    {
                        <div class="verification-meta">

                            <div>

                                <span>
                                    Xác minh bởi
                                </span>

                                <strong>
                                    @(
                                        user.VerifiedByUserName
                                        ?? "Admin"
                                    )
                                </strong>

                            </div>


                            <div>

                                <span>
                                    Thời gian
                                </span>

                                <strong>
                                    @(
                                        user.VerifiedAt.HasValue
                                            ? user.VerifiedAt.Value
                                                .ToLocalTime()
                                                .ToString("dd/MM/yyyy HH:mm")
                                            : "—"
                                    )
                                </strong>

                            </div>

                        </div>
                    }
                }

            </section>


            <!-- =================================================
                 SECURITY
                 ================================================= -->

            <section class="detail-card">

                <div class="detail-card-heading">

                    <div class="detail-card-icon red">

                        <svg viewBox="0 0 24 24">
                            <path d="M17 8h-1V6a4 4 0 0 0-8 0v2H7a2 2 0 0 0-2 2v10h12V10a2 2 0 0 0-2-2Zm-7-2a2 2 0 1 1 4 0v2h-4V6Zm5 12H9v-8h6v8Z" />
                        </svg>

                    </div>

                    <div>

                        <h2>
                            Trạng thái bảo mật
                        </h2>

                        <p>
                            Thông tin khóa tài khoản
                        </p>

                    </div>

                </div>


                @if (Model.IsLocked)
                {
                    <div class="locked-summary">

                        <div class="locked-badge">
                            Tài khoản đang bị khóa
                        </div>


                        <div class="detail-info-list">

                            <div class="detail-info-row">

                                <span>
                                    Lý do
                                </span>

                                <strong>
                                    @(
                                        user.LockedReason
                                        ?? "Không có lý do"
                                    )
                                </strong>

                            </div>


                            <div class="detail-info-row">

                                <span>
                                    Khóa bởi
                                </span>

                                <strong>
                                    @(
                                        user.LockedByUserName
                                        ?? "Admin"
                                    )
                                </strong>

                            </div>


                            <div class="detail-info-row">

                                <span>
                                    Thời gian khóa
                                </span>

                                <strong>
                                    @(
                                        user.LockedAt.HasValue
                                            ? user.LockedAt.Value
                                                .ToLocalTime()
                                                .ToString("dd/MM/yyyy HH:mm")
                                            : "—"
                                    )
                                </strong>

                            </div>

                        </div>

                    </div>
                }
                else
                {
                    <div class="account-safe">

                        <div class="safe-icon">
                            ✓
                        </div>

                        <div>

                            <strong>
                                Tài khoản đang hoạt động
                            </strong>

                            <p>
                                Không có thông tin khóa tài khoản.
                            </p>

                        </div>

                    </div>
                }

            </section>

        </div>


        <!-- =================================================
             ACTION AREA
             ================================================= -->

        <section class="detail-action-card">

            <div>

                <h2>
                    Thao tác quản trị
                </h2>

                <p>
                    Quản lý trạng thái tài khoản và
                    xác minh hồ sơ người dùng.
                </p>

            </div>


            <div class="detail-action-buttons">

                @if (isCurrentAdmin)
                {
                    <span class="current-admin-note">

                        Đây là tài khoản Admin hiện tại

                    </span>
                }
                else
                {
                    @if (Model.IsStudent &&
                         user.IsProfileVerified != true &&
                         !Model.IsLocked &&
                         user.StudentId.HasValue)
                    {
                        <button type="button"
                                class="detail-action-button verify"
                                data-bs-toggle="modal"
                                data-bs-target="#verifyStudentModal">

                            <svg viewBox="0 0 24 24">
                                <path d="m9 16.2-3.5-3.5L4.1 14.1 9 19l11-11-1.4-1.4L9 16.2Z" />
                            </svg>

                            Xác minh sinh viên

                        </button>
                    }


                    @if (Model.IsLandlord &&
                         user.IsProfileVerified != true &&
                         !Model.IsLocked &&
                         user.LandlordId.HasValue)
                    {
                        <button type="button"
                                class="detail-action-button verify"
                                data-bs-toggle="modal"
                                data-bs-target="#verifyLandlordModal">

                            <svg viewBox="0 0 24 24">
                                <path d="m9 16.2-3.5-3.5L4.1 14.1 9 19l11-11-1.4-1.4L9 16.2Z" />
                            </svg>

                            Xác minh chủ trọ

                        </button>
                    }


                    @if (Model.IsLocked)
                    {
                        <button type="button"
                                class="detail-action-button unlock"
                                data-bs-toggle="modal"
                                data-bs-target="#unlockUserModal">

                            <svg viewBox="0 0 24 24">
                                <path d="M17 8h-7V6a2 2 0 1 1 4 0h2a4 4 0 0 0-8 0v2H7a2 2 0 0 0-2 2v10h14V10a2 2 0 0 0-2-2Zm0 10H7v-8h10v8Z" />
                            </svg>

                            Mở khóa

                        </button>
                    }
                    else
                    {
                        <button type="button"
                                class="detail-action-button lock"
                                data-bs-toggle="modal"
                                data-bs-target="#lockUserModal">

                            <svg viewBox="0 0 24 24">
                                <path d="M17 8h-1V6a4 4 0 0 0-8 0v2H7a2 2 0 0 0-2 2v10h12V10a2 2 0 0 0-2-2Zm-7-2a2 2 0 1 1 4 0v2h-4V6Zm5 12H9v-8h6v8Z" />
                            </svg>

                            Khóa tài khoản

                        </button>
                    }
                }

            </div>

        </section>
    }


    <!-- =====================================================
         MODALS
         Chỉ render khi load được user
         ===================================================== -->
    @if (user is not null)
    {
        <!-- =================================================
             LOCK MODAL
             ================================================= -->
        @if (!isCurrentAdmin &&
                     !Model.IsLocked)
        {
            <div class="modal fade"
                 id="lockUserModal"
                 tabindex="-1"
                 aria-hidden="true">

                <div class="modal-dialog modal-dialog-centered">

                    <div class="modal-content admin-action-modal">

                        <form asp-controller="Users"
                              asp-action="Lock"
                              method="post"
                              id="lockUserForm"
                              novalidate>

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@user.UserId" />

                            <input type="hidden"
                                   name="returnUrl"
                                   value="@Model.ReturnUrl" />


                            <div class="modal-header">

                                <div>

                                    <h5 class="modal-title">
                                        Khóa tài khoản
                                    </h5>

                                    <p>
                                        Hành động này sẽ ngăn người dùng
                                        tiếp tục sử dụng tài khoản.
                                    </p>

                                </div>


                                <button type="button"
                                        class="btn-close"
                                        data-bs-dismiss="modal">
                                </button>

                            </div>


                            <div class="modal-body">

                                <div class="action-user-summary">

                                    <strong>
                                        @user.FullName
                                    </strong>

                                    <span>
                                        @user.Email
                                    </span>

                                </div>


                                <label for="lockReason">

                                    Lý do khóa

                                    <span>*</span>

                                </label>


                                <textarea id="lockReason"
                                          name="reason"
                                          maxlength="500"
                                          placeholder="Nhập lý do khóa tài khoản..."></textarea>


                                <div class="lock-reason-error"
                                     id="lockReasonError"
                                     hidden>

                                    Vui lòng nhập lý do khóa tài khoản.

                                </div>


                                <small>
                                    Tối đa 500 ký tự.
                                </small>

                            </div>


                            <div class="modal-footer">

                                <button type="button"
                                        class="modal-cancel-button"
                                        data-bs-dismiss="modal">

                                    Hủy

                                </button>


                                <button type="submit"
                                        class="modal-danger-button">

                                    Xác nhận khóa

                                </button>

                            </div>

                        </form>

                    </div>

                </div>

            </div>
        }


        <!-- =================================================
             UNLOCK MODAL
             ================================================= -->
        @if (!isCurrentAdmin &&
                     Model.IsLocked)
        {
            <div class="modal fade"
                 id="unlockUserModal"
                 tabindex="-1"
                 aria-hidden="true">

                <div class="modal-dialog modal-dialog-centered">

                    <div class="modal-content admin-action-modal">

                        <form asp-controller="Users"
                              asp-action="Unlock"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@user.UserId" />

                            <input type="hidden"
                                   name="returnUrl"
                                   value="@Model.ReturnUrl" />


                            <div class="modal-header">

                                <div>

                                    <h5 class="modal-title">
                                        Mở khóa tài khoản
                                    </h5>

                                    <p>
                                        Người dùng sẽ có thể đăng nhập
                                        và sử dụng Roomify trở lại.
                                    </p>

                                </div>


                                <button type="button"
                                        class="btn-close"
                                        data-bs-dismiss="modal">
                                </button>

                            </div>


                            <div class="modal-body">

                                <div class="action-user-summary">

                                    <strong>
                                        @user.FullName
                                    </strong>

                                    <span>
                                        @user.Email
                                    </span>

                                </div>


                                <div class="action-confirm-text">

                                    Bạn có chắc muốn mở khóa
                                    tài khoản này?

                                </div>

                            </div>


                            <div class="modal-footer">

                                <button type="button"
                                        class="modal-cancel-button"
                                        data-bs-dismiss="modal">

                                    Hủy

                                </button>


                                <button type="submit"
                                        class="modal-primary-button">

                                    Xác nhận mở khóa

                                </button>

                            </div>

                        </form>

                    </div>

                </div>

            </div>
        }


        <!-- =================================================
             VERIFY STUDENT MODAL
             ================================================= -->
        @if (!isCurrentAdmin &&
                     Model.IsStudent &&
                     user.IsProfileVerified != true &&
                     !Model.IsLocked &&
                     user.StudentId.HasValue)
        {
            <div class="modal fade"
                 id="verifyStudentModal"
                 tabindex="-1"
                 aria-hidden="true">

                <div class="modal-dialog modal-dialog-centered">

                    <div class="modal-content admin-action-modal">

                        <form asp-controller="Users"
                              asp-action="VerifyStudent"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@user.UserId" />

