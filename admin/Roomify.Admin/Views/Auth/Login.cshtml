@model Roomify.Admin.Models.Auth.LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập quản trị";
    Layout = "_AuthLayout";
}

<div class="auth-page">

    <!-- Top security bar -->
    <header class="auth-topbar">

        <div class="auth-topbar-inner">

            <div class="security-note">
                <svg viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="M12 2 5 5v6c0 5 3 9 7 11 4-2 7-6 7-11V5l-7-3Zm0 2.2 5 2.1V11c0 3.9-2.1 7.1-5 8.8C9.1 18.1 7 14.9 7 11V6.3l5-2.1Z" />
                </svg>

                <span>
                    Khu vực quản trị hệ thống Roomify
                </span>
            </div>

            <div class="system-status">
                <span class="status-dot"></span>
                <span>Hệ thống quản trị</span>
            </div>

        </div>

    </header>


    <!-- Main -->
    <main class="auth-main">

        <section class="login-card">

            <!-- Brand -->
            <div class="login-brand">

                <div class="logo-box">
                    <img src="~/images/roomify-logo.png"
                         alt="Roomify" />
                </div>

                <h1>Roomify Admin</h1>

                <p>
                    Đăng nhập hệ thống quản trị
                </p>

            </div>


            <!-- Form -->
            <form asp-controller="Auth"
                  asp-action="Login"
                  method="post"
                  class="login-form"
                  id="adminLoginForm"
                  novalidate>

                @Html.AntiForgeryToken()

                <input asp-for="ReturnUrl"
                       type="hidden" />

                <!-- Email -->
                <div class="form-field">

                    <label asp-for="Email"
                           class="field-label">
                        Email quản trị viên
                        <span>*</span>
                    </label>

                    <div class="input-wrapper">

                        <span class="input-icon">
                            <svg viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4-8 5-8-5V6l8 5 8-5v2Z" />
                            </svg>
                        </span>

                        <input asp-for="Email"
                               class="form-control roomify-input"
                               placeholder="admin@roomify.vn"
                               autocomplete="username" />

                    </div>

                    <span asp-validation-for="Email"
                          class="field-error">
                    </span>

                    <div class="field-helper">
                        Sử dụng tài khoản được cấp quyền bởi ban quản trị
                    </div>

                </div>


                <!-- Password -->
                <div class="form-field">

                    <div class="password-label-row">

                        <label asp-for="Password"
                               class="field-label">
                            Mật khẩu
                            <span>*</span>
                        </label>

                        <span class="forgot-placeholder">
                            Bảo mật tài khoản
                        </span>

                    </div>

                    <div class="input-wrapper">

                        <span class="input-icon">
                            <svg viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <path d="M17 8h-1V6a4 4 0 0 0-8 0v2H7a2 2 0 0 0-2 2v10h14V10a2 2 0 0 0-2-2Zm-7-2a2 2 0 1 1 4 0v2h-4V6Zm7 12H7v-8h10v8Z" />
                            </svg>
                        </span>

                        <input asp-for="Password"
                               type="password"
                               id="passwordInput"
                               class="form-control roomify-input password-input"
                               placeholder="Nhập mật khẩu quản trị"
                               autocomplete="current-password" />

                        <button type="button"
                                class="password-toggle"
                                id="togglePassword"
                                aria-label="Hiện mật khẩu">

                            <svg id="eyeIcon"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <path d="M12 5C7 5 3 8.1 1.5 12 3 15.9 7 19 12 19s9-3.1 10.5-7C21 8.1 17 5 12 5Zm0 12c-3.7 0-6.8-2.1-8.2-5C5.2 9.1 8.3 7 12 7s6.8 2.1 8.2 5c-1.4 2.9-4.5 5-8.2 5Zm0-8a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z" />
                            </svg>

                        </button>

                    </div>

                    <span asp-validation-for="Password"
                          class="field-error">
                    </span>

                </div>


                <!-- Remember -->
                <div class="remember-row">

                    <label class="remember-label">

                        <input asp-for="RememberMe"
                               class="form-check-input" />

                        <span>
                            Ghi nhớ đăng nhập
                        </span>

                    </label>

                </div>


                <!-- Server/API error -->
                @if (!ViewData.ModelState.IsValid &&
                     ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="login-alert"
                         role="alert">

                        <svg viewBox="0 0 24 24"
                             aria-hidden="true">
                            <path d="M12 2 1 21h22L12 2Zm0 4.2L19.6 19H4.4L12 6.2ZM11 10v4h2v-4h-2Zm0 5.5v2h2v-2h-2Z" />
                        </svg>

                        <div>
                            @foreach (var error in
                                ViewData.ModelState[string.Empty]!.Errors)
                            {
                                <div>@error.ErrorMessage</div>
                            }
                        </div>

                    </div>
                }


                <!-- Login -->
                <button type="submit"
                        class="btn-login"
                        id="loginButton">

                    <span id="loginButtonText">
                        Đăng nhập
                    </span>

                    <svg viewBox="0 0 24 24"
                         aria-hidden="true">
                        <path d="m9 18 6-6-6-6v12Z" />
                    </svg>

                </button>

            </form>


            <!-- Security notice -->
            <div class="security-box">

                <div class="security-badge">

                    <svg viewBox="0 0 24 24"
                         aria-hidden="true">
                        <path d="M17 8h-1V6a4 4 0 0 0-8 0v2H7v12h10V8Zm-7-2a2 2 0 1 1 4 0v2h-4V6Z" />
                    </svg>

                    <span>
                        Không hỗ trợ đăng ký tài khoản công khai
                    </span>

                </div>

                <p>
                    Chỉ tài khoản có quyền ADMIN mới có thể truy cập.
                </p>

            </div>

        </section>

    </main>


    <!-- Footer -->
    <footer class="auth-footer">
        © 2026 Roomify
    </footer>

</div>