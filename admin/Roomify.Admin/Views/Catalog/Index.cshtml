@section Scripts {

    <script>

                document.addEventListener(
             "DOMContentLoaded",
             function () {

                 // =====================================================
                // CREATE VALIDATION
        // =====================================================

                  const createForm =
                   document.getElementById(
                        "createPropertyTypeForm");

            const createName =
             document.getElementById(
                        "createTypeName");

             const createError =
                document.getElementById(
                "createTypeNameError");


                      if (createForm &&
                   createName &&
                        createError) {

                      createName.addEventListener(
                            "input",
                function () {

                              if (createName.value.trim()) {

                        createError.hidden = true;

                                createName.classList.remove(
                            "is-invalid-field");
                    }

                });


                        createForm.addEventListener(
                        "submit",
                        function (event) {

                    if (!createName.value.trim()) {

                      event.preventDefault();

                        createError.hidden = false;

                        createName.classList.add(
                    "is-invalid-field");

                                createName.focus();
                    }

                });
        }


               // =====================================================
            // EDIT MODAL DATA
                  // =====================================================

        const editModal =
                      document.getElementById(
                       "editPropertyTypeModal");


                    if (editModal) {

                         editModal.addEventListener(
                        "show.bs.modal",
                        function (event) {

                        const button =
                            event.relatedTarget;


                       if (!button) {
                        return;
                            }


                              const id =
                                 button.getAttribute(
                                    "data-id");

                             const name =
                        button.getAttribute(
                                    "data-name");

                     const active =
                        button.getAttribute(
                    "data-active");


                     document.getElementById(
                            "editPropertyTypeId"
                       ).value = id ?? "";


                    document.getElementById(
                       "editTypeName"
                        ).value = name ?? "";


                            document.getElementById(
                         "editIsActive"
                          ).checked =
                                  active === "true";


                      const error =
                        document.getElementById(
                                    "editTypeNameError");


                    error.hidden = true;


            document.getElementById(
                "editTypeName"
                            ).classList.remove(
                        "is-invalid-field");

                });
        }


                     // =====================================================
               // EDIT VALIDATION
        // =====================================================

                  const editForm =
                   document.getElementById(
                        "editPropertyTypeForm");

                const editName =
                document.getElementById(
                        "editTypeName");

            const editError =
                document.getElementById(
                "editTypeNameError");


                     if (editForm &&
                  editName &&
                        editError) {

                       editName.addEventListener(
                            "input",
                function () {

                                if (editName.value.trim()) {

                        editError.hidden = true;

                                editName.classList.remove(
                            "is-invalid-field");
                    }

                });


                        editForm.addEventListener(
                               "submit",
                        function (event) {

                    if (!editName.value.trim()) {

                      event.preventDefault();

                        editError.hidden = false;

                                editName.classList.add(
                        "is-invalid-field");

                                editName.focus();
                    }

                    });
                }


                // =====================================================
                // AMENITY CREATE VALIDATION
                // =====================================================

                const createAmenityForm =
                    document.getElementById(
                        "createAmenityForm");

                const createAmenityName =
                    document.getElementById(
                        "createAmenityName");

                const createAmenityError =
                    document.getElementById(
                        "createAmenityNameError");


                if (createAmenityForm &&
                    createAmenityName &&
                    createAmenityError) {

                    createAmenityName.addEventListener(
                        "input",
                        function () {

                            if (createAmenityName.value.trim()) {

                                createAmenityError.hidden = true;

                                createAmenityName.classList.remove(
                                    "is-invalid-field");
                            }

                        });


                    createAmenityForm.addEventListener(
                        "submit",
                        function (event) {

                            if (!createAmenityName.value.trim()) {

                                event.preventDefault();

                                createAmenityError.hidden = false;

                                createAmenityName.classList.add(
                                    "is-invalid-field");

                                createAmenityName.focus();
                            }

                        });
                }


                // =====================================================
                // AMENITY EDIT MODAL DATA
                // =====================================================

                const editAmenityModal =
                    document.getElementById(
                        "editAmenityModal");


                if (editAmenityModal) {

                    editAmenityModal.addEventListener(
                        "show.bs.modal",
                        function (event) {

                            const button =
                                event.relatedTarget;


                            if (!button) {
                                return;
                            }


                            document.getElementById(
                                "editAmenityId"
                            ).value =
                                button.getAttribute(
                                    "data-id") ?? "";


                            document.getElementById(
                                "editAmenityName"
                            ).value =
                                button.getAttribute(
                                    "data-name") ?? "";


                            document.getElementById(
                                "editAmenityIcon"
                            ).value =
                                button.getAttribute(
                                    "data-icon") ?? "";


                            document.getElementById(
                                "editAmenityIsActive"
                            ).checked =
                                button.getAttribute(
                                    "data-active")
                                === "true";


                            const amenityError =
                                document.getElementById(
                                    "editAmenityNameError");


                            amenityError.hidden = true;


                            document.getElementById(
                                "editAmenityName"
                            ).classList.remove(
                                "is-invalid-field");

                        });
                }


                // =====================================================
                // AMENITY EDIT VALIDATION
                // =====================================================

                const editAmenityForm =
                    document.getElementById(
                        "editAmenityForm");

                const editAmenityName =
                    document.getElementById(
                        "editAmenityName");

                const editAmenityError =
                    document.getElementById(
                        "editAmenityNameError");


                if (editAmenityForm &&
                    editAmenityName &&
                    editAmenityError) {

                    editAmenityName.addEventListener(
                        "input",
                        function () {

                            if (editAmenityName.value.trim()) {

                                editAmenityError.hidden = true;

                                editAmenityName.classList.remove(
                                    "is-invalid-field");
                            }

                        });


                    editAmenityForm.addEventListener(
                        "submit",
                        function (event) {

                            if (!editAmenityName.value.trim()) {

                                event.preventDefault();

                                editAmenityError.hidden = false;

                                editAmenityName.classList.add(
                                    "is-invalid-field");

                                editAmenityName.focus();
                            }

                        });
                }

                // =====================================================
                // UNIVERSITY REQUIRED TEXT VALIDATION
                // =====================================================

                function setupRequiredText(
                    formId,
                    inputId,
                    errorId) {

                    const form =
                        document.getElementById(
                            formId);

                    const input =
                        document.getElementById(
                            inputId);

                    const error =
                        document.getElementById(
                            errorId);


                    if (!form ||
                        !input ||
                        !error) {
                        return;
                    }


                    input.addEventListener(
                        "input",
                        function () {

                            if (input.value.trim()) {

                                error.hidden = true;

                                input.classList.remove(
                                    "is-invalid-field");
                            }

                        });


                    form.addEventListener(
                        "submit",
                        function (event) {

                            if (!input.value.trim()) {

                                event.preventDefault();

                                error.hidden = false;

                                input.classList.add(
                                    "is-invalid-field");

                                input.focus();
                            }

                        });
                }


                setupRequiredText(
                    "createUniversityForm",
                    "createUniversityName",
                    "createUniversityNameError");


                setupRequiredText(
                    "editUniversityForm",
                    "editUniversityName",
                    "editUniversityNameError");


                // =====================================================
                // UNIVERSITY PROVINCE -> WARD
                // =====================================================

                const wardsUrl =
                    '@Url.Action("Wards", "Catalog")';


                async function loadWards(
                    provinceId,
                    wardSelect,
                    selectedWardId = null) {

                    if (!wardSelect) {
                        return;
                    }


                    wardSelect.innerHTML =
                        '<option value="">Chọn phường/xã</option>';


                    if (!provinceId) {

                        wardSelect.disabled =
                            true;

                        return;
                    }


                    wardSelect.disabled =
                        true;


                    try {

                        const response =
                            await fetch(
                                `${wardsUrl}?provinceId=${encodeURIComponent(provinceId)}`,
                                {
                                    headers: {
                                        "X-Requested-With":
                                            "XMLHttpRequest"
                                    }
                                });


                        if (response.status === 401) {

                            window.location.href =
                                '@Url.Action("Login", "Auth")';

                            return;
                        }


                        if (!response.ok) {
                            return;
                        }


                        const wards =
                            await response.json();


                        wards.forEach(
                            function (ward) {

                                const option =
                                    document.createElement(
                                        "option");


                                option.value =
                                    ward.wardId;


                                option.textContent =
                                    ward.wardName;


                                if (
                                    selectedWardId &&
                                    String(ward.wardId)
                                    === String(selectedWardId)
                                ) {
                                    option.selected =
                                        true;
                                }


                                wardSelect.appendChild(
                                    option);

                            });


                        wardSelect.disabled =
                            false;

                    }
                    catch {

                        wardSelect.disabled =
                            true;
                    }
                }


                // =====================================================
                // CREATE UNIVERSITY LOCATION
                // =====================================================

                const createProvince =
                    document.getElementById(
                        "createProvinceId");

                const createWard =
                    document.getElementById(
                        "createWardId");


                if (createProvince &&
                    createWard) {

                    createProvince.addEventListener(
                        "change",
                        function () {

                            loadWards(
                                createProvince.value,
                                createWard);

                        });
                }


                // =====================================================
                // EDIT UNIVERSITY MODAL DATA
                // =====================================================

                const editUniversityModal =
                    document.getElementById(
                        "editUniversityModal");


                if (editUniversityModal) {

                    editUniversityModal.addEventListener(
                        "show.bs.modal",
                        async function (event) {

                            const button =
                                event.relatedTarget;


                            if (!button) {
                                return;
                            }


                            const universityId =
                                button.getAttribute(
                                    "data-id") ?? "";

                            const name =
                                button.getAttribute(
                                    "data-name") ?? "";

                            const provinceId =
                                button.getAttribute(
                                    "data-province") ?? "";

                            const wardId =
                                button.getAttribute(
                                    "data-ward") ?? "";

                            const address =
                                button.getAttribute(
                                    "data-address") ?? "";

                            const latitude =
                                button.getAttribute(
                                    "data-latitude") ?? "";

                            const longitude =
                                button.getAttribute(
                                    "data-longitude") ?? "";

                            const active =
                                button.getAttribute(
                                    "data-active")
                                === "true";


                            document.getElementById(
                                "editUniversityId"
                            ).value =
                                universityId;


                            document.getElementById(
                                "editUniversityName"
                            ).value =
                                name;


                            document.getElementById(
                                "editProvinceId"
                            ).value =
                                provinceId;


                            document.getElementById(
                                "editAddressLine"
                            ).value =
                                address;


                            document.getElementById(
                                "editLatitude"
                            ).value =
                                latitude;


                            document.getElementById(
                                "editLongitude"
                            ).value =
                                longitude;


                            document.getElementById(
                                "editUniversityIsActive"
                            ).checked =
                                active;


                            const error =
                                document.getElementById(
                                    "editUniversityNameError");


                            error.hidden =
                                true;


                            document.getElementById(
                                "editUniversityName"
                            ).classList.remove(
                                "is-invalid-field");


                            const wardSelect =
                                document.getElementById(
                                    "editWardId");


                            await loadWards(
                                provinceId,
                                wardSelect,
                                wardId);

                        });
                }


                // =====================================================
                // EDIT UNIVERSITY LOCATION
                // =====================================================

                const editProvince =
                    document.getElementById(
                        "editProvinceId");

                const editWard =
                    document.getElementById(
                        "editWardId");


                if (editProvince &&
                    editWard) {

                    editProvince.addEventListener(
                        "change",
                        function () {

                            loadWards(
                                editProvince.value,
                                editWard);

                        });
                }


            });

    </script>

}