@model Roomify.Admin.Models.Catalog.AdminCatalogViewModel

@{
    ViewData["Title"] = "Danh mục";

    var currentUrl =
        $"{Context.Request.Path}{Context.Request.QueryString}";
}


@section Styles {

    <link rel="stylesheet"
          href="~/css/admin-catalog.css"
          asp-append-version="true" />

}


<div class="catalog-page">

    <!-- =====================================================
         HEADER
         ===================================================== -->

    <section class="catalog-heading">

        <div>

            <div class="catalog-breadcrumb">

                Trang chủ

                <span>›</span>

                <strong>
                    Danh mục
                </strong>

            </div>


            <h1>
                Quản lý danh mục
            </h1>


            <p>
                Quản lý dữ liệu dùng chung trong hệ thống Roomify.
            </p>

        </div>


        @if (Model.IsPropertyTypesTab)
        {
            <button type="button"
                    class="catalog-add-button"
                    data-bs-toggle="modal"
                    data-bs-target="#createPropertyTypeModal">

                <span>+</span>

                Thêm loại hình

            </button>
        }
        else if (Model.IsAmenitiesTab)
        {
            <button type="button"
                    class="catalog-add-button"
                    data-bs-toggle="modal"
                    data-bs-target="#createAmenityModal">

                <span>+</span>

                Thêm tiện ích

            </button>
        }
        else if (Model.IsUniversitiesTab)
        {
            <button type="button"
                    class="catalog-add-button"
                    data-bs-toggle="modal"
                    data-bs-target="#createUniversityModal">

                <span>+</span>

                Thêm trường đại học

            </button>
        }

    </section>


    <!-- =====================================================
         FLASH MESSAGE
         ===================================================== -->
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="catalog-alert success">

            <span>
                ✓
            </span>

            <div>
                @successMessage
            </div>

        </div>
    }


    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="catalog-alert error">

            <span>
                !
            </span>

            <div>
                @errorMessage
            </div>

        </div>
    }


    <!-- =====================================================
         CATALOG TYPE TABS
         ===================================================== -->

    <nav class="catalog-main-tabs">

        <a asp-controller="Catalog"
           asp-action="Index"
           asp-route-tab="property-types"
           class="@(Model.IsPropertyTypesTab ? "active" : "")">

            <span class="catalog-tab-icon">
                ▦
            </span>
            <div>
                <strong>
                    Loại hình nhà trọ
                </strong>

                <small>
                    Property Types
                </small>
            </div>
        </a>

        <a asp-controller="Catalog"
           asp-action="Index"
           asp-route-tab="amenities"
           class="@(Model.IsAmenitiesTab ? "active" : "")">

            <span class="catalog-tab-icon">
                ◇
            </span>

            <div>

                <strong>
                    Tiện ích
                </strong>

                <small>
                    Amenities
                </small>

            </div>

        </a>

        <a asp-controller="Catalog"
           asp-action="Index"
           asp-route-tab="universities"
           class="@(Model.IsUniversitiesTab ? "active" : "")">

            <span class="catalog-tab-icon">
                ◉
            </span>

            <div>

                <strong>
                    Trường đại học
                </strong>

                <small>
                    Universities
                </small>

            </div>

        </a>
    </nav>


    <!-- =====================================================
         KPI
         ===================================================== -->
    @if (Model.IsPropertyTypesTab)
    {
        <section class="catalog-kpi-grid">

            <article class="catalog-kpi-card">

                <span>
                    Tổng loại hình
                </span>

                <strong>
                    @Model.TotalPropertyTypes
                </strong>

                <small>
                    Tất cả loại hình nhà trọ
                </small>

            </article>


            <article class="catalog-kpi-card">

                <span>
                    Đang hoạt động
                </span>

                <strong class="green">
                    @Model.ActivePropertyTypes
                </strong>

                <small>
                    Có thể sử dụng trên hệ thống
                </small>

            </article>


            <article class="catalog-kpi-card">

                <span>
                    Đã vô hiệu hóa
                </span>

                <strong class="red">
                    @Model.InactivePropertyTypes
                </strong>

                <small>
                    Tạm ngừng sử dụng
                </small>

            </article>

        </section>
    }
    else if (Model.IsAmenitiesTab)
    {
        <section class="catalog-kpi-grid">

            <article class="catalog-kpi-card">

                <span>
                    Tổng tiện ích
                </span>

                <strong>
                    @Model.TotalAmenities
                </strong>

                <small>
                    Tất cả tiện ích trên hệ thống
                </small>

            </article>


            <article class="catalog-kpi-card">

                <span>
                    Đang hoạt động
                </span>

                <strong class="green">
                    @Model.ActiveAmenities
                </strong>

                <small>
                    Có thể gắn vào phòng trọ
                </small>

            </article>


            <article class="catalog-kpi-card">

                <span>
                    Đã vô hiệu hóa
                </span>

                <strong class="red">
                    @Model.InactiveAmenities
                </strong>

                <small>
                    Tạm ngừng sử dụng
                </small>

            </article>

        </section>
    }
    else if (Model.IsUniversitiesTab)
    {
        <section class="catalog-kpi-grid">

            <article class="catalog-kpi-card">

                <span>
                    Tổng trường đại học
                </span>

                <strong>
                    @Model.TotalUniversities
                </strong>

                <small>
                    Tất cả trường trong hệ thống
                </small>

            </article>


            <article class="catalog-kpi-card">

                <span>
                    Đang hoạt động
                </span>

                <strong class="green">
                    @Model.ActiveUniversities
                </strong>

                <small>
                    Có thể được sinh viên lựa chọn
                </small>

            </article>


            <article class="catalog-kpi-card">

                <span>
                    Đã vô hiệu hóa
                </span>

                <strong class="red">
                    @Model.InactiveUniversities
                </strong>

                <small>
                    Tạm ngừng sử dụng
                </small>

            </article>

        </section>
    }

    <!-- =====================================================
         FILTER
         ===================================================== -->

    <section class="catalog-filter-card">

        <form asp-controller="Catalog"
              asp-action="Index"
              method="get">

            <div class="catalog-filter-row">

                <div class="catalog-search">

                    <svg viewBox="0 0 24 24">
                        <path d="M10.5 4a6.5 6.5 0 1 0 4.1 11.5L20 20.9l1.4-1.4-5.4-5.4A6.5 6.5 0 0 0 10.5 4Zm0 2a4.5 4.5 0 1 1 0 9 4.5 4.5 0 0 1 0-9Z" />
                    </svg>

                    <input type="hidden"
                           name="tab"
                           value="@Model.ActiveTab" />

                    <input type="text"
                           name="search"
                           value="@Model.Search"
                           placeholder="@(
                           Model.IsUniversitiesTab
                               ? "Tìm tên trường, địa chỉ, tỉnh/thành, phường/xã..."
                               : Model.IsAmenitiesTab
                                   ? "Tìm theo tên tiện ích hoặc Icon URL..."
                                   : "Tìm theo tên loại hình..."
                       )" />

                </div>


                <select name="status">

                    <option value="">
                        Tất cả trạng thái
                    </option>

                    <option value="ACTIVE"
                            selected="@(Model.Status == "ACTIVE")">

                        Đang hoạt động

                    </option>

                    <option value="INACTIVE"
                            selected="@(Model.Status == "INACTIVE")">

                        Đã vô hiệu hóa

                    </option>

                </select>


                <button type="submit"
                        class="catalog-filter-button">
                    Lọc
                </button>

                <a asp-controller="Catalog"
                   asp-action="Index"
                   asp-route-tab="@Model.ActiveTab"
                   class="catalog-reset-button">
                    Đặt lại
                </a>

            </div>

        </form>

    </section>


    <!-- =====================================================
         ERROR / EMPTY
         ===================================================== -->
    @if (Model.HasError)
    {
        <section class="catalog-state">

            <div class="catalog-state-icon error">
                !
            </div>

            <h2>
                Không thể tải danh mục
            </h2>

            <p>
                @Model.ErrorMessage
            </p>

        </section>
    }
    else if (Model.IsEmpty)
    {
        <section class="catalog-state">

            <div class="catalog-state-icon">
                @(Model.IsUniversitiesTab
                    ? "◉"
                    : Model.IsAmenitiesTab
                        ? "◇"
                        : "▦")
            </div>

            <h2>
                @(Model.IsUniversitiesTab
                    ? "Không tìm thấy trường đại học"
                    : Model.IsAmenitiesTab
                        ? "Không tìm thấy tiện ích"
                        : "Không tìm thấy loại hình")
            </h2>

            <p>
                @(Model.IsUniversitiesTab
                    ? "Không có trường đại học phù hợp với điều kiện tìm kiếm."
                    : Model.IsAmenitiesTab
                        ? "Không có tiện ích phù hợp với điều kiện tìm kiếm."
                        : "Không có loại hình nhà trọ phù hợp với điều kiện tìm kiếm.")
            </p>

        </section>
    }
    else if (Model.IsPropertyTypesTab)
    {
        <!-- =================================================
             PROPERTY TYPES TABLE
             ================================================= -->

        <section class="catalog-table-card">

            <div class="catalog-table-header">

                <div>

                    <h2>
                        Loại hình nhà trọ
                    </h2>

                    <p>
                        Quản lý các loại hình được Landlord sử dụng khi tạo khu trọ.
                    </p>

                </div>

                <span>
                    @Model.PropertyTypes.Count kết quả
                </span>

            </div>

            <div class="catalog-table-wrapper">

                <table class="catalog-table">

                    <thead>

                        <tr>

                            <th>
                                ID
                            </th>

                            <th>
                                Tên loại hình
                            </th>

                            <th>
                                Trạng thái
                            </th>

                            <th>
                                Thao tác
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model.PropertyTypes)
                        {
                            <tr class="@(!item.IsActive
                                ? "catalog-inactive-row"
                                : "")">

                                <td>

                                    <span class="catalog-id">
                                        #PT-@item.PropertyTypeId
                                    </span>

                                </td>

                                <td>

                                    <div class="catalog-name-cell">

                                        <div class="catalog-item-icon">
                                            ▦
                                        </div>

                                        <div>

                                            <strong>
                                                @item.TypeName
                                            </strong>

                                            <span>
                                                Property Type
                                            </span>

                                        </div>

                                    </div>

                                </td>

                                <td>

                                    @if (item.IsActive)
                                    {
                                        <span class="catalog-status active">
                                            Đang hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="catalog-status inactive">
                                            Đã vô hiệu hóa
                                        </span>
                                    }

                                </td>

                                <td>

                                    <div class="dropdown">

                                        <button type="button"
                                                class="catalog-action-button"
                                                data-bs-toggle="dropdown"
                                                aria-expanded="false"
                                                title="Thao tác">

                                            ⋮

                                        </button>

                                        <div class="dropdown-menu dropdown-menu-end catalog-action-menu">

                                            <button type="button"
                                                    class="dropdown-item js-edit-property-type"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#editPropertyTypeModal"
                                                    data-id="@item.PropertyTypeId"
                                                    data-name="@item.TypeName"
                                                    data-active="@item.IsActive.ToString().ToLowerInvariant()">

                                                Chỉnh sửa

                                            </button>

                                            <div class="dropdown-divider">
                                            </div>

                                            @if (item.IsActive)
                                            {
                                                <form asp-controller="Catalog"
                                                      asp-action="DeactivatePropertyType"
                                                      method="post"
                                                      class="catalog-inline-form">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="propertyTypeId"
                                                           value="@item.PropertyTypeId" />

                                                    <input type="hidden"
                                                           name="returnUrl"
                                                           value="@currentUrl" />

                                                    <button type="submit"
                                                            class="dropdown-item danger"
                                                            onclick="return confirm('Bạn có chắc muốn vô hiệu hóa loại hình này?');">

                                                        Vô hiệu hóa

                                                    </button>

                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-controller="Catalog"
                                                      asp-action="ActivatePropertyType"
                                                      method="post"
                                                      class="catalog-inline-form">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="propertyTypeId"
                                                           value="@item.PropertyTypeId" />

                                                    <input type="hidden"
                                                           name="returnUrl"
                                                           value="@currentUrl" />

                                                    <button type="submit"
                                                            class="dropdown-item success">

                                                        Kích hoạt

                                                    </button>

                                                </form>
                                            }

                                        </div>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </section>
    }
    else if (Model.IsAmenitiesTab)
    {
        <!-- =================================================
             AMENITIES TABLE
             ================================================= -->

        <section class="catalog-table-card">

            <div class="catalog-table-header">

                <div>

                    <h2>
                        Tiện ích
                    </h2>

                    <p>
                        Quản lý các tiện ích Landlord có thể gắn vào phòng trọ.
                    </p>

                </div>

                <span>
                    @Model.Amenities.Count kết quả
                </span>

            </div>

            <div class="catalog-table-wrapper">

                <table class="catalog-table catalog-amenity-table">

                    <thead>

                        <tr>

                            <th>
                                ID
                            </th>

                            <th>
                                Tiện ích
                            </th>

                            <th>
                                Icon URL
                            </th>

                            <th>
                                Trạng thái
                            </th>

                            <th>
                                Thao tác
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model.Amenities)
                        {
                            <tr class="@(!item.IsActive
                                ? "catalog-inactive-row"
                                : "")">

                                <td>

                                    <span class="catalog-id">
                                        #AM-@item.AmenityId
                                    </span>

                                </td>

                                <td>

                                    <div class="catalog-name-cell">

                                        <div class="catalog-item-icon amenity">
                                            ◇
                                        </div>

                                        <div>

                                            <strong>
                                                @item.AmenityName
                                            </strong>

                                            <span>
                                                Amenity
                                            </span>

                                        </div>

                                    </div>

                                </td>

                                <td>

                                    @if (string.IsNullOrWhiteSpace(item.IconUrl))
                                    {
                                        <span class="catalog-empty-value">
                                            Chưa có icon
                                        </span>
                                    }
                                    else
                                    {
                                        <div class="catalog-icon-url"
                                             title="@item.IconUrl">

                                            @item.IconUrl

                                        </div>
                                    }

                                </td>

                                <td>

                                    @if (item.IsActive)
                                    {
                                        <span class="catalog-status active">
                                            Đang hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="catalog-status inactive">
                                            Đã vô hiệu hóa
                                        </span>
                                    }

                                </td>

                                <td>

                                    <div class="dropdown">

                                        <button type="button"
                                                class="catalog-action-button"
                                                data-bs-toggle="dropdown"
                                                aria-expanded="false"
                                                title="Thao tác">

                                            ⋮

                                        </button>

                                        <div class="dropdown-menu dropdown-menu-end catalog-action-menu">

                                            <button type="button"
                                                    class="dropdown-item js-edit-amenity"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#editAmenityModal"
                                                    data-id="@item.AmenityId"
                                                    data-name="@item.AmenityName"
                                                    data-icon="@item.IconUrl"
                                                    data-active="@item.IsActive.ToString().ToLowerInvariant()">

                                                Chỉnh sửa

                                            </button>

                                            <div class="dropdown-divider">
                                            </div>

                                            @if (item.IsActive)
                                            {
                                                <form asp-controller="Catalog"
                                                      asp-action="DeactivateAmenity"
                                                      method="post"
                                                      class="catalog-inline-form">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="amenityId"
                                                           value="@item.AmenityId" />

                                                    <input type="hidden"
                                                           name="returnUrl"
                                                           value="@currentUrl" />

                                                    <button type="submit"
                                                            class="dropdown-item danger"
                                                            onclick="return confirm('Bạn có chắc muốn vô hiệu hóa tiện ích này?');">

                                                        Vô hiệu hóa

                                                    </button>

                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-controller="Catalog"
                                                      asp-action="ActivateAmenity"
                                                      method="post"
                                                      class="catalog-inline-form">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="amenityId"
                                                           value="@item.AmenityId" />

                                                    <input type="hidden"
                                                           name="returnUrl"
                                                           value="@currentUrl" />

                                                    <button type="submit"
                                                            class="dropdown-item success">

                                                        Kích hoạt

                                                    </button>

                                                </form>
                                            }

                                        </div>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </section>
    }
    else if (Model.IsUniversitiesTab)
    {
        <!-- =================================================
             UNIVERSITIES TABLE
             ================================================= -->

        <section class="catalog-table-card">

            <div class="catalog-table-header">

                <div>

                    <h2>
                        Trường đại học
                    </h2>

                    <p>
                        Quản lý danh sách trường đại học được sử dụng trong hồ sơ sinh viên.
                    </p>

                </div>

                <span>
                    @Model.Universities.Count kết quả
                </span>

            </div>


            <div class="catalog-table-wrapper">

                <table class="catalog-table catalog-university-table">

                    <thead>

                        <tr>

                            <th>ID</th>

                            <th>Trường đại học</th>

                            <th>Khu vực</th>

                            <th>Tọa độ</th>

                            <th>Trạng thái</th>

                            <th>Thao tác</th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var item in Model.Universities)
                        {
                            var latitudeValue =
                                item.Latitude?.ToString(
                                    System.Globalization.CultureInfo.InvariantCulture);

                            var longitudeValue =
                                item.Longitude?.ToString(
                                    System.Globalization.CultureInfo.InvariantCulture);

                            <tr class="@(!item.IsActive
                                ? "catalog-inactive-row"
                                : "")">

                                <td>

                                    <span class="catalog-id">
                                        #UNI-@item.UniversityId
                                    </span>

                                </td>


                                <td>

                                    <div class="catalog-name-cell">

                                        <div class="catalog-item-icon university">
                                            ◉
                                        </div>


                                        <div>

                                            <strong>
                                                @item.UniversityName
                                            </strong>

                                            <span title="@item.AddressLine">
                                                @(string.IsNullOrWhiteSpace(item.AddressLine)
                                                    ? "Chưa có địa chỉ"
                                                    : item.AddressLine)
                                            </span>

                                        </div>

                                    </div>

                                </td>


                                <td>

                                    <div class="catalog-location-cell">

                                        <strong>
                                            @(item.ProvinceName ?? "—")
                                        </strong>

                                        <span>
                                            @(item.WardName ?? "Chưa chọn phường/xã")
                                        </span>

                                    </div>

                                </td>


                                <td>

                                    @if (item.Latitude.HasValue &&
                                         item.Longitude.HasValue)
                                    {
                                        <div class="catalog-coordinate">

                                            <span>
                                                Lat: @item.Latitude.Value.ToString("0.######")
                                            </span>

                                            <span>
                                                Lng: @item.Longitude.Value.ToString("0.######")
                                            </span>

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="catalog-empty-value">
                                            Chưa có tọa độ
                                        </span>
                                    }

                                </td>


                                <td>

                                    @if (item.IsActive)
                                    {
                                        <span class="catalog-status active">
                                            Đang hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="catalog-status inactive">
                                            Đã vô hiệu hóa
                                        </span>
                                    }

                                </td>


                                <td>

                                    <div class="dropdown">

                                        <button type="button"
                                                class="catalog-action-button"
                                                data-bs-toggle="dropdown"
                                                aria-expanded="false"
                                                title="Thao tác">

                                            ⋮

                                        </button>


                                        <div class="dropdown-menu dropdown-menu-end catalog-action-menu">

                                            <button type="button"
                                                    class="dropdown-item js-edit-university"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#editUniversityModal"
                                                    data-id="@item.UniversityId"
                                                    data-name="@item.UniversityName"
                                                    data-province="@item.ProvinceId"
                                                    data-ward="@item.WardId"
                                                    data-address="@item.AddressLine"
                                                    data-latitude="@latitudeValue"
                                                    data-longitude="@longitudeValue"
                                                    data-active="@item.IsActive.ToString().ToLowerInvariant()">

                                                Chỉnh sửa

                                            </button>


                                            <div class="dropdown-divider">
                                            </div>


                                            @if (item.IsActive)
                                            {
                                                <form asp-controller="Catalog"
                                                      asp-action="DeactivateUniversity"
                                                      method="post"
                                                      class="catalog-inline-form">

                                                    @Html.AntiForgeryToken()


                                                    <input type="hidden"
                                                           name="universityId"
                                                           value="@item.UniversityId" />


                                                    <input type="hidden"
                                                           name="returnUrl"
                                                           value="@currentUrl" />


                                                    <button type="submit"
                                                            class="dropdown-item danger"
                                                            onclick="return confirm('Bạn có chắc muốn vô hiệu hóa trường đại học này?');">

                                                        Vô hiệu hóa

                                                    </button>

                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-controller="Catalog"
                                                      asp-action="ActivateUniversity"
                                                      method="post"
                                                      class="catalog-inline-form">

                                                    @Html.AntiForgeryToken()


                                                    <input type="hidden"
                                                           name="universityId"
                                                           value="@item.UniversityId" />


                                                    <input type="hidden"
                                                           name="returnUrl"
