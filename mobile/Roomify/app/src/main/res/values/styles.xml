<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- LARGE HEADING - 24SP BOLD -->
    <style name="TextAppearance.Roomify.Large"
        parent="TextAppearance.Material3.TitleLarge">

        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/roomify_text_large</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- SECTION HEADING - 20SP BOLD -->
    <style name="TextAppearance.Roomify.Section"
        parent="TextAppearance.Material3.TitleMedium">

        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/roomify_text_section</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- CARD TITLE - 16SP SEMIBOLD -->
    <style name="TextAppearance.Roomify.CardTitle"
        parent="TextAppearance.Material3.TitleMedium">

        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textSize">@dimen/roomify_text_card</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textFontWeight">600</item>
    </style>

    <!-- BODY - 14SP REGULAR -->
    <style name="TextAppearance.Roomify.Body"
        parent="TextAppearance.Material3.BodyMedium">

        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textSize">@dimen/roomify_text_body</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- SECONDARY - 13SP -->
    <style name="TextAppearance.Roomify.Secondary"
        parent="TextAppearance.Material3.BodySmall">

        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textSize">@dimen/roomify_text_secondary</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- CAPTION - 12SP -->
    <style name="TextAppearance.Roomify.Caption"
        parent="TextAppearance.Material3.BodySmall">

        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textSize">@dimen/roomify_text_caption</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <!-- PRIMARY MATERIAL BUTTON -->
    <style name="Widget.Roomify.Button.Primary"
        parent="Widget.Material3.Button">

        <item name="backgroundTint">@color/primary_blue</item>
        <item name="android:textColor">@color/surface_white</item>
        <item name="cornerRadius">@dimen/roomify_corner_radius</item>
        <item name="android:minHeight">@dimen/roomify_control_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="fontFamily">@font/plus_jakarta_sans</item>
    </style>

    <!-- ACCENT BUTTON -->
    <style name="Widget.Roomify.Button.Brand"
        parent="Widget.Roomify.Button.Primary">

        <item name="backgroundTint">@color/brand_blue</item>
    </style>

    <!-- OUTLINED TEXT INPUT -->
    <style name="Widget.Roomify.TextInput"
        parent="Widget.Material3.TextInputLayout.OutlinedBox">

        <item name="boxBackgroundColor">@color/surface_white</item>
        <item name="boxStrokeColor">@color/primary_blue</item>

        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>

        <item name="hintTextColor">@color/text_muted</item>
    </style>

</resources>
