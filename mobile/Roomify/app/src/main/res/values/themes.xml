<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Base.Theme.Roomify"
        parent="Theme.Material3.Light.NoActionBar">

        <!-- BRAND COLORS -->
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorOnPrimary">@color/surface_white</item>
        <item name="colorSecondary">@color/brand_blue</item>

        <!-- SURFACE -->
        <item name="colorSurface">@color/surface_white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOutline">@color/stroke_border</item>

        <!-- ERROR -->
        <item name="colorError">@color/status_error</item>

        <!-- DEFAULT FONT -->
        <item name="fontFamily">@font/plus_jakarta_sans</item>

        <!-- WINDOW -->
        <item name="android:windowBackground">@color/surface_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

    </style>

    <style name="Theme.Roomify"
        parent="Base.Theme.Roomify" />

</resources>
