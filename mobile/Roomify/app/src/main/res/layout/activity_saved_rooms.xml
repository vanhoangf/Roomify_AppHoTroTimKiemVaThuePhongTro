<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/savedRoomsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg">

    <!-- ===================================================== -->
    <!-- HEADER -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/savedHeader"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@color/surface_white"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            style="@style/TextAppearance.Roomify.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Phòng đã lưu"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- SUMMARY -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/savedSummary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/savedHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            style="@style/TextAppearance.Roomify.CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Phòng bạn quan tâm"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvCount"
            style="@style/TextAppearance.Roomify.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Đang tải danh sách phòng đã lưu..."
            android:textColor="@color/text_muted" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- CONTENT -->
    <!-- ===================================================== -->

    <FrameLayout
        android:id="@+id/savedContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/savedSummary"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSavedRooms"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingTop="4dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp"
            android:scrollbars="none"
            android:visibility="gone" />


        <ProgressBar
            android:id="@+id/progressSavedRooms"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center" />


        <!-- EMPTY / ERROR -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/stateContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/surface_white"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/stroke_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:gravity="center"
                    android:text="♡"
                    android:textColor="@color/primary_blue"
                    android:textSize="38sp" />

                <TextView
                    android:id="@+id/tvStateMessage"
                    style="@style/TextAppearance.Roomify.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="Bạn chưa lưu phòng nào"
                    android:textColor="@color/text_primary" />

                <TextView
                    style="@style/TextAppearance.Roomify.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Nhấn biểu tượng yêu thích ở phòng bạn quan tâm để lưu lại."
                    android:textColor="@color/text_muted" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetry"
                    style="@style/Widget.Roomify.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="18dp"
                    android:text="Thử lại"
                    android:textAllCaps="false"
                    android:visibility="gone"
                    app:cornerRadius="14dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>


    <!-- ===================================================== -->
    <!-- BOTTOM NAV -->
    <!-- ===================================================== -->

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="68dp"
        android:background="@color/surface_white"
        android:elevation="8dp"

        app:menu="@menu/menu_student_bottom"
        app:labelVisibilityMode="labeled"

        app:itemIconSize="22dp"
        app:itemIconTint="@color/student_nav_tint"
        app:itemTextColor="@color/student_nav_tint"

        app:itemTextAppearanceActive="@style/TextAppearance.Roomify.NavActive"
        app:itemTextAppearanceInactive="@style/TextAppearance.Roomify.NavInactive"

        app:itemActiveIndicatorStyle="@style/Widget.Roomify.StudentNav.ActiveIndicator"

        app:itemPaddingTop="2dp"
        app:itemPaddingBottom="2dp"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>