<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/editProfileRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg"
    android:orientation="vertical">

    <!-- ===================================================== -->
    <!-- HEADER -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/surface_white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Quay lại"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            style="@style/TextAppearance.Roomify.Section"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Chỉnh sửa hồ sơ"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />

        <Space
            android:layout_width="48dp"
            android:layout_height="1dp" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- CONTENT -->
    <!-- ===================================================== -->

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="32dp">


                <!-- ================================================= -->
                <!-- INTRO -->
                <!-- ================================================= -->

                <TextView
                    style="@style/TextAppearance.Roomify.Large"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cập nhật hồ sơ"
                    android:textColor="@color/text_primary" />

                <TextView
                    style="@style/TextAppearance.Roomify.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp"
                    android:text="Thông tin chính xác giúp Roomify hỗ trợ bạn tốt hơn trong quá trình tìm và thuê phòng." />


                <!-- ================================================= -->
                <!-- PERSONAL INFORMATION -->
                <!-- ================================================= -->

                <TextView
                    style="@style/TextAppearance.Roomify.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="Thông tin cá nhân"
                    android:textColor="@color/text_primary" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@color/surface_white"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/stroke_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- FULL NAME LABEL -->
                        <TextView
                            style="@style/TextAppearance.Roomify.CardTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Họ và tên"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <TextView
                            style="@style/TextAppearance.Roomify.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Tên này sẽ được hiển thị trong tài khoản Roomify." />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilFullName"
                            style="@style/Widget.Roomify.TextInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:hint="Nhập họ và tên">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtFullName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPersonName|textCapWords"
                                android:maxLength="150"
                                android:minHeight="54dp"
                                android:singleLine="true" />

                        </com.google.android.material.textfield.TextInputLayout>


                        <!-- DIVIDER -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="18dp"
                            android:layout_marginBottom="16dp"
                            android:background="@color/stroke_border" />


                        <!-- PHONE LABEL -->
                        <TextView
                            style="@style/TextAppearance.Roomify.CardTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Số điện thoại"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <TextView
                            style="@style/TextAppearance.Roomify.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Dùng để chủ trọ có thể liên hệ với bạn khi cần." />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilPhone"
                            style="@style/Widget.Roomify.TextInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:hint="Nhập số điện thoại">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtPhone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="phone"
                                android:maxLength="20"
                                android:minHeight="54dp"
                                android:singleLine="true" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- ================================================= -->
                <!-- STUDENT INFORMATION -->
                <!-- ================================================= -->

                <TextView
                    style="@style/TextAppearance.Roomify.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="Thông tin sinh viên"
                    android:textColor="@color/text_primary" />

                <TextView
                    style="@style/TextAppearance.Roomify.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Thông tin này được sử dụng để xác minh tài khoản sinh viên." />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@color/surface_white"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/stroke_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- UNIVERSITY -->
                        <TextView
                            style="@style/TextAppearance.Roomify.CardTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Trường đại học"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <TextView
                            style="@style/TextAppearance.Roomify.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Chọn trường mà bạn đang theo học." />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilUniversity"
                            style="@style/Widget.Roomify.TextInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:hint="Chọn trường đại học"
                            app:endIconMode="dropdown_menu">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/actUniversity"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:inputType="none"
                                android:maxLines="2"
                                android:minHeight="56dp"
                                android:paddingTop="8dp"
                                android:paddingBottom="8dp" />

                        </com.google.android.material.textfield.TextInputLayout>


                        <!-- DIVIDER -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="18dp"
                            android:layout_marginBottom="16dp"
                            android:background="@color/stroke_border" />


                        <!-- STUDENT CODE -->
                        <TextView
                            style="@style/TextAppearance.Roomify.CardTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Mã sinh viên"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <TextView
                            style="@style/TextAppearance.Roomify.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Nhập đúng mã sinh viên do trường cung cấp." />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilStudentCode"
                            style="@style/Widget.Roomify.TextInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:hint="Nhập mã sinh viên">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtStudentCode"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textCapCharacters"
                                android:maxLength="50"
                                android:minHeight="54dp"
                                android:singleLine="true" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- ================================================= -->
                <!-- VERIFICATION WARNING -->
                <!-- ================================================= -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    app:cardBackgroundColor="@color/surface_light"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/stroke_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:gravity="center"
                            android:text="!"
                            android:textColor="@color/primary_blue"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.Roomify.CardTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Lưu ý về xác minh"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" />

                            <TextView
                                style="@style/TextAppearance.Roomify.Secondary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:lineSpacingExtra="2dp"
                                android:text="Nếu thay đổi trường đại học hoặc mã sinh viên, trạng thái xác minh hiện tại sẽ được đặt lại và bạn cần xác minh lại." />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <Space
                    android:layout_width="match_parent"
                    android:layout_height="20dp" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>


        <!-- ================================================= -->
        <!-- LOADING -->
        <!-- ================================================= -->

        <ProgressBar
            android:id="@+id/progressProfile"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center" />

    </FrameLayout>


    <!-- ===================================================== -->
    <!-- BOTTOM SAVE ACTION -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_white"
        android:elevation="10dp"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            style="@style/Widget.Roomify.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Lưu thay đổi"
            android:textAllCaps="false"
            android:textSize="15sp"
            app:cornerRadius="14dp" />

    </LinearLayout>

</LinearLayout>