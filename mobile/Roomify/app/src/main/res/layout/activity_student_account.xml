<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/accountRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg">

    <!-- ================= HEADER ================= -->

    <LinearLayout
        android:id="@+id/accountHeader"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@color/surface_white"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            style="@style/TextAppearance.Roomify.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Tài khoản"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />

    </LinearLayout>


    <!-- ================= CONTENT ================= -->

    <FrameLayout
        android:id="@+id/accountContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/accountHeader"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="18dp"
                android:paddingEnd="20dp"
                android:paddingBottom="28dp">


                <!-- ================================================= -->
                <!-- PROFILE -->
                <!-- ================================================= -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/surface_white"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/stroke_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- AVATAR + BASIC INFO -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/ivAvatar"
                                android:layout_width="76dp"
                                android:layout_height="76dp"
                                android:contentDescription="Ảnh đại diện"
                                android:scaleType="centerCrop"
                                android:src="@drawable/roomify_logo" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvFullName"
                                    style="@style/TextAppearance.Roomify.Large"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:maxLines="2"
                                    android:text="Sinh viên Roomify"
                                    android:textColor="@color/text_primary"
                                    android:textSize="20sp" />

                                <TextView
                                    android:id="@+id/tvEmail"
                                    style="@style/TextAppearance.Roomify.Secondary"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:text="student@roomify.demo"
                                    android:textColor="@color/text_muted" />

                                <TextView
                                    android:id="@+id/tvProfileUniversity"
                                    style="@style/TextAppearance.Roomify.Body"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:maxLines="2"
                                    android:text="Trường đại học"
                                    android:textColor="@color/text_secondary" />

                            </LinearLayout>

                        </LinearLayout>


                        <!-- VERIFIED STATUS -->
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipVerification"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Chưa xác minh sinh viên"
                            android:textSize="12sp"
                            app:chipBackgroundColor="@color/chip_bg"
                            app:ensureMinTouchTargetSize="false" />


                        <!-- EDIT PROFILE -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEditProfile"
                            style="@style/Widget.Roomify.Button.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="14dp"
                            android:text="Chỉnh sửa hồ sơ"
                            android:textAllCaps="false"
                            app:cornerRadius="14dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- ================================================= -->
                <!-- PERSONAL INFORMATION -->
                <!-- ================================================= -->

                <TextView
                    style="@style/TextAppearance.Roomify.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:text="Thông tin của bạn"
                    android:textColor="@color/text_primary" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@color/surface_white"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/stroke_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- PHONE -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="72dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="18dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/TextAppearance.Roomify.Caption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Điện thoại"
                                    android:textColor="@color/text_muted" />

                                <TextView
                                    android:id="@+id/tvPhone"
                                    style="@style/TextAppearance.Roomify.CardTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="0911000001"
                                    android:textColor="@color/text_primary" />

                            </LinearLayout>

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="18dp"
                            android:background="@color/stroke_border" />

                        <!-- UNIVERSITY -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="76dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="18dp"
                            android:paddingVertical="12dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/TextAppearance.Roomify.Caption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Trường đại học"
                                    android:textColor="@color/text_muted" />

                                <TextView
                                    android:id="@+id/tvUniversity"
                                    style="@style/TextAppearance.Roomify.CardTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:maxLines="2"
                                    android:text="Trường Đại học Bách khoa - Đại học Đà Nẵng"
                                    android:textColor="@color/text_primary" />

                            </LinearLayout>

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="18dp"
                            android:background="@color/stroke_border" />

                        <!-- STUDENT CODE -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="72dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="18dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/TextAppearance.Roomify.Caption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Mã sinh viên"
                                    android:textColor="@color/text_muted" />

                                <TextView
                                    android:id="@+id/tvStudentCode"
                                    style="@style/TextAppearance.Roomify.CardTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="SV260001"
                                    android:textColor="@color/text_primary" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- ================================================= -->
                <!-- ACTIVITY -->
                <!-- ================================================= -->

                <TextView
                    style="@style/TextAppearance.Roomify.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:text="Hoạt động của tôi"
                    android:textColor="@color/text_primary" />

                <TextView
                    style="@style/TextAppearance.Roomify.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Quản lý toàn bộ quá trình tìm và thuê phòng."
                    android:textColor="@color/text_muted" />


                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@color/surface_white"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/stroke_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- APPOINTMENT -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAppointments"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:gravity="start|center_vertical"
                            android:paddingHorizontal="18dp"
                            android:text="Lịch xem phòng"
                            android:textAllCaps="false"
                            android:textColor="@color/text_primary" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="18dp"
                            android:background="@color/stroke_border" />

                        <!-- RENTAL REQUEST -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRentalRequests"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:gravity="start|center_vertical"
                            android:paddingHorizontal="18dp"
                            android:text="Yêu cầu thuê phòng"
                            android:textAllCaps="false"
                            android:textColor="@color/text_primary" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="18dp"
                            android:background="@color/stroke_border" />

                        <!-- CONTRACT -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnContracts"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:gravity="start|center_vertical"
                            android:paddingHorizontal="18dp"
                            android:text="Hợp đồng của tôi"
                            android:textAllCaps="false"
                            android:textColor="@color/text_primary" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="18dp"
                            android:background="@color/stroke_border" />

                        <!-- PAYMENT -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPayments"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:gravity="start|center_vertical"
                            android:paddingHorizontal="18dp"
                            android:text="Thanh toán"
                            android:textAllCaps="false"
                            android:textColor="@color/text_primary" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- ================================================= -->
                <!-- CONNECTION -->
                <!-- ================================================= -->

                <TextView
                    style="@style/TextAppearance.Roomify.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:text="Kết nối"
                    android:textColor="@color/text_primary" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@color/surface_white"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/stroke_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMessages"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:gravity="start|center_vertical"
                            android:paddingHorizontal="18dp"
                            android:text="Tin nhắn với chủ trọ"
                            android:textAllCaps="false"
                            android:textColor="@color/text_primary" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="18dp"
                            android:background="@color/stroke_border" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnNotifications"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:gravity="start|center_vertical"
                            android:paddingHorizontal="18dp"
                            android:text="Thông báo"
                            android:textAllCaps="false"
                            android:textColor="@color/text_primary" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- ================================================= -->
                <!-- LOGOUT -->
                <!-- ================================================= -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogout"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="26dp"
                    android:text="Đăng xuất"
                    android:textAllCaps="false"
                    android:textColor="@color/status_error"
                    app:cornerRadius="14dp" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>


        <!-- ================= LOADING ================= -->

        <ProgressBar
            android:id="@+id/progressAccount"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center" />


        <!-- ================= ERROR ================= -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/errorContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="20dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/surface_white"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/stroke_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:id="@+id/tvError"
                    style="@style/TextAppearance.Roomify.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Không thể tải thông tin tài khoản."
                    android:textColor="@color/text_muted" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetry"
                    style="@style/Widget.Roomify.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:text="Thử lại"
                    android:textAllCaps="false"
                    app:cornerRadius="14dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>


    <!-- ================= BOTTOM NAV ================= -->

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="68dp"
        android:background="@color/surface_white"
        android:elevation="8dp"

        app:menu="@menu/menu_student_bottom"
        app:labelVisibilityMode="labeled"

        app:itemIconSize="22dp"
        app:itemIconTint="@color/student_nav_tint"
        app:itemTextColor="@color/student_nav_tint"

        app:itemTextAppearanceActive="@style/TextAppearance.Roomify.NavActive"
        app:itemTextAppearanceInactive="@style/TextAppearance.Roomify.NavInactive"

        app:itemActiveIndicatorStyle="@style/Widget.Roomify.StudentNav.ActiveIndicator"

        app:itemPaddingTop="2dp"
        app:itemPaddingBottom="2dp"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>