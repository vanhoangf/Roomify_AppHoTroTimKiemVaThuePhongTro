<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/roomDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_bg">

    <!-- ================================================= -->
    <!-- MAIN CONTENT -->
    <!-- ================================================= -->

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ================================================= -->
                <!-- HERO IMAGE -->
                <!-- ================================================= -->

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="290dp">

                    <ImageView
                        android:id="@+id/ivRoomImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/room_image_placeholder"
                        android:scaleType="centerCrop"
                        android:contentDescription="Ảnh phòng" />

                    <!-- IMAGE SCRIM -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:background="@drawable/detail_image_scrim" />

                    <!-- BACK -->
                    <ImageButton
                        android:id="@+id/btnBack"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="top|start"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        android:padding="10dp"
                        android:background="@drawable/bg_detail_icon_button"
                        android:src="@drawable/ic_arrow_back"
                        android:contentDescription="Quay lại" />

                    <!-- IMAGE COUNT -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="16dp"
                        app:cardBackgroundColor="#EFFFFFFF"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp">

                        <TextView
                            android:id="@+id/tvImageCount"
                            style="@style/TextAppearance.Roomify.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="8dp"
                            android:text="1 ảnh"
                            android:textColor="@color/text_primary" />

                    </com.google.android.material.card.MaterialCardView>

                </FrameLayout>

                <!-- ================================================= -->
                <!-- ROOM MAIN INFO -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="20dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="32dp">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipRoomStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Còn trống"
                        android:textColor="@color/status_success"
                        android:textSize="12sp"
                        app:chipBackgroundColor="@color/chip_bg"
                        app:chipCornerRadius="12dp"
                        app:chipMinHeight="32dp"
                        app:chipStartPadding="6dp"
                        app:chipEndPadding="6dp"
                        app:ensureMinTouchTargetSize="false" />

                    <TextView
                        android:id="@+id/tvRoomTitle"
                        style="@style/TextAppearance.Roomify.Large"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Phòng Roomify Demo 01" />

                    <TextView
                        android:id="@+id/tvRoomPrice"
                        style="@style/TextAppearance.Roomify.Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="1.700.000 đ/tháng"
                        android:textColor="@color/primary_blue" />

                    <TextView
                        android:id="@+id/tvAddress"
                        style="@style/TextAppearance.Roomify.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Hòa Khánh, Đà Nẵng" />

                    <!-- ================================================= -->
                    <!-- QUICK INFORMATION -->
                    <!-- ================================================= -->

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        app:cardBackgroundColor="@color/surface_white"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/stroke_border"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="18dp">

                            <!-- AREA -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvArea"
                                    style="@style/TextAppearance.Roomify.CardTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="20 m²" />

                                <TextView
                                    style="@style/TextAppearance.Roomify.Caption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="Diện tích" />

                            </LinearLayout>

                            <View
                                android:layout_width="1dp"
                                android:layout_height="40dp"
                                android:background="@color/stroke_border" />

                            <!-- OCCUPANTS -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvOccupants"
                                    style="@style/TextAppearance.Roomify.CardTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="2 người" />

                                <TextView
                                    style="@style/TextAppearance.Roomify.Caption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="Tối đa" />

                            </LinearLayout>

                            <View
                                android:layout_width="1dp"
                                android:layout_height="40dp"
                                android:background="@color/stroke_border" />

                            <!-- TYPE -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvPropertyType"
                                    style="@style/TextAppearance.Roomify.CardTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:text="Phòng trọ" />

                                <TextView
                                    style="@style/TextAppearance.Roomify.Caption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="Loại hình" />

                            </LinearLayout>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- ================================================= -->
                    <!-- DESCRIPTION -->
                    <!-- ================================================= -->

                    <TextView
                        style="@style/TextAppearance.Roomify.Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:text="Mô tả phòng" />

                    <TextView
                        android:id="@+id/tvDescription"
                        style="@style/TextAppearance.Roomify.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="4dp"
                        android:text="Thông tin mô tả phòng." />

                    <!-- ================================================= -->
                    <!-- AMENITIES -->
                    <!-- ================================================= -->

                    <TextView
                        style="@style/TextAppearance.Roomify.Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:text="Tiện ích" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupAmenities"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="8dp" />

                    <!-- ================================================= -->
                    <!-- COST -->
                    <!-- ================================================= -->

                    <TextView
                        style="@style/TextAppearance.Roomify.Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:text="Chi phí" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardBackgroundColor="@color/surface_white"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/stroke_border"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <!-- DEPOSIT -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical">

                                <TextView
                                    style="@style/TextAppearance.Roomify.Body"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Tiền cọc" />

                                <TextView
                                    android:id="@+id/tvDeposit"
                                    style="@style/TextAppearance.Roomify.CardTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Chưa cập nhật" />

                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginVertical="12dp"
                                android:background="@color/stroke_border" />

                            <!-- ELECTRICITY -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <TextView
                                    style="@style/TextAppearance.Roomify.Body"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Điện" />

                                <TextView
                                    android:id="@+id/tvElectricity"
                                    style="@style/TextAppearance.Roomify.Body"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" />

                            </LinearLayout>

                            <!-- WATER -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp">

                                <TextView
                                    style="@style/TextAppearance.Roomify.Body"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Nước" />

                                <TextView
                                    android:id="@+id/tvWater"
                                    style="@style/TextAppearance.Roomify.Body"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" />

                            </LinearLayout>

                            <!-- INTERNET -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp">

                                <TextView
                                    style="@style/TextAppearance.Roomify.Body"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Internet" />

                                <TextView
                                    android:id="@+id/tvInternet"
                                    style="@style/TextAppearance.Roomify.Body"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" />

                            </LinearLayout>

                            <!-- SERVICE -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp">

                                <TextView
                                    style="@style/TextAppearance.Roomify.Body"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Phí dịch vụ" />

                                <TextView
                                    android:id="@+id/tvServiceFee"
                                    style="@style/TextAppearance.Roomify.Body"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" />

                            </LinearLayout>

                            <!-- PARKING -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp">

                                <TextView
                                    style="@style/TextAppearance.Roomify.Body"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Gửi xe" />

                                <TextView
                                    android:id="@+id/tvParkingFee"
                                    style="@style/TextAppearance.Roomify.Body"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" />

                            </LinearLayout>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- ================================================= -->
                    <!-- PROPERTY / LANDLORD -->
                    <!-- ================================================= -->

                    <TextView
                        style="@style/TextAppearance.Roomify.Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:text="Thông tin khu trọ" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardBackgroundColor="@color/surface_light"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/tvPropertyName"
                                style="@style/TextAppearance.Roomify.CardTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Roomify Demo" />

                            <TextView
                                android:id="@+id/tvPropertyDescription"
                                style="@style/TextAppearance.Roomify.Body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp" />

                            <TextView
                                android:id="@+id/tvVerified"
                                style="@style/TextAppearance.Roomify.Secondary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:textColor="@color/status_success" />

                            <TextView
                                android:id="@+id/tvViewCount"
                                style="@style/TextAppearance.Roomify.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- ================================================= -->
                    <!-- CONTACT -->
                    <!-- ================================================= -->

                    <TextView
                        style="@style/TextAppearance.Roomify.Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:text="Liên hệ chủ trọ" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCall"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:text="Gọi điện"
                            android:textAllCaps="false"
                            android:enabled="false" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMessage"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:text="Nhắn tin"
                            android:textAllCaps="false"
                            android:enabled="false" />

                    </LinearLayout>

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="12dp" />

                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <!-- ================================================= -->
        <!-- LOADING -->
        <!-- ================================================= -->

        <ProgressBar
            android:id="@+id/progressDetail"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center" />

        <!-- ================================================= -->
        <!-- ERROR -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/errorContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvError"
                style="@style/TextAppearance.Roomify.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Không thể tải chi tiết phòng." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetry"
                style="@style/Widget.Roomify.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Thử lại"
                android:textAllCaps="false" />

        </LinearLayout>

    </FrameLayout>

    <!-- ================================================= -->
    <!-- FIXED ACTION BAR -->
    <!-- ================================================= -->

    <LinearLayout
        android:id="@+id/actionContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_white"
        android:elevation="12dp"
        android:orientation="horizontal"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewingAppointment"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:text="Đặt lịch xem"
            android:textAllCaps="false"
            android:enabled="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRentalRequest"
            style="@style/Widget.Roomify.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Yêu cầu thuê"
            android:textAllCaps="false"
            android:enabled="false" />

    </LinearLayout>

</LinearLayout>