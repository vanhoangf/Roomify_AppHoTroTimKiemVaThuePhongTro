<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="@color/surface_white"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/stroke_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ROOM IMAGE -->
        <ImageView
            android:id="@+id/ivRoom"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="@color/surface_light"
            android:scaleType="centerCrop"
            android:contentDescription="Ảnh phòng trọ" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- TITLE + STATUS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvRoomTitle"
                    style="@style/TextAppearance.Roomify.CardTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:text="Tên phòng" />

                <TextView
                    android:id="@+id/tvRoomStatus"
                    style="@style/TextAppearance.Roomify.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/status_success"
                    android:text="Còn trống" />

            </LinearLayout>

            <!-- PRICE -->
            <TextView
                android:id="@+id/tvRoomPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/primary_blue"
                android:text="0 ₫/tháng" />

            <!-- AREA -->
            <TextView
                android:id="@+id/tvRoomArea"
                style="@style/TextAppearance.Roomify.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Diện tích" />

            <!-- OCCUPANTS -->
            <TextView
                android:id="@+id/tvRoomOccupants"
                style="@style/TextAppearance.Roomify.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Số người tối đa" />

            <!-- ADDRESS -->
            <TextView
                android:id="@+id/tvRoomAddress"
                style="@style/TextAppearance.Roomify.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="Địa chỉ phòng trọ" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
