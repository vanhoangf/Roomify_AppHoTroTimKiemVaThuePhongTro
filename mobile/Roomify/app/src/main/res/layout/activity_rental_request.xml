<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rentalRequestRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg"
    android:orientation="vertical">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/surface_white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Quay lại"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            style="@style/TextAppearance.Roomify.Section"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Yêu cầu thuê phòng" />

        <Space
            android:layout_width="48dp"
            android:layout_height="1dp" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ROOM INFO -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface_white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/stroke_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextAppearance.Roomify.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PHÒNG MUỐN THUÊ" />

                    <TextView
                        android:id="@+id/tvRoomTitle"
                        style="@style/TextAppearance.Roomify.CardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Tên phòng" />

                    <TextView
                        android:id="@+id/tvPropertyName"
                        style="@style/TextAppearance.Roomify.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Tên khu trọ" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- MOVE IN DATE -->
            <TextView
                style="@style/TextAppearance.Roomify.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Ngày dự kiến chuyển vào" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectMoveInDate"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:gravity="start|center_vertical"
                android:text="Chọn ngày chuyển vào"
                android:textAllCaps="false" />

            <!-- DURATION -->
            <TextView
                style="@style/TextAppearance.Roomify.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Thời hạn thuê" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDuration"
                style="@style/Widget.Roomify.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Số tháng, ví dụ 6">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtDuration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="3"
                    android:singleLine="true" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/TextAppearance.Roomify.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Có thể để trống. Nếu nhập, thời hạn từ 1 đến 120 tháng." />

            <!-- NOTE -->
            <TextView
                style="@style/TextAppearance.Roomify.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Lời nhắn cho chủ trọ" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNote"
                style="@style/Widget.Roomify.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Ví dụ: Em muốn thuê dài hạn và có thể chuyển vào đầu tháng tới"
                app:counterEnabled="true"
                app:counterMaxLength="1500">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtNote"
                    android:layout_width="match_parent"
                    android:layout_height="130dp"
                    android:gravity="top|start"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLength="1500"
                    android:paddingTop="16dp" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/surface_light"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp">

                <TextView
                    style="@style/TextAppearance.Roomify.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp"
                    android:text="Sau khi gửi, yêu cầu sẽ ở trạng thái chờ xử lý. Chủ trọ có thể chấp nhận hoặc từ chối. Đây không phải là hợp đồng thuê." />

            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="match_parent"
                android:layout_height="16dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- ACTIONS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface_white"
        android:elevation="10dp"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <!-- PRIMARY ACTION -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmit"
            style="@style/Widget.Roomify.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Gửi yêu cầu thuê"
            android:textAllCaps="false" />

        <!-- SECONDARY ACTION -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMyRentalRequests"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:text="Yêu cầu thuê của tôi"
            android:textAllCaps="false"
            android:textColor="@color/primary_blue" />

    </LinearLayout>

</LinearLayout>