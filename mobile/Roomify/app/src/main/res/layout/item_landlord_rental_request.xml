<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardLandlordRentalRequest"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="6dp"
    android:layout_marginTop="7dp"
    android:layout_marginEnd="6dp"
    android:layout_marginBottom="7dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/surface_white"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/stroke_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvStudentName"
                style="@style/TextAppearance.Roomify.CardTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sinh viên" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chờ xử lý"
                android:textSize="11sp"
                app:chipBackgroundColor="@color/chip_bg"
                app:ensureMinTouchTargetSize="false" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvRoomTitle"
            style="@style/TextAppearance.Roomify.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Phòng 101" />

        <TextView
            android:id="@+id/tvPropertyName"
            style="@style/TextAppearance.Roomify.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Khu trọ" />

        <TextView
            style="@style/TextAppearance.Roomify.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="DỰ KIẾN CHUYỂN VÀO" />

        <TextView
            android:id="@+id/tvMoveInDate"
            style="@style/TextAppearance.Roomify.CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="01/12/2026" />

        <TextView
            android:id="@+id/tvDuration"
            style="@style/TextAppearance.Roomify.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Thời hạn dự kiến: 12 tháng" />

        <TextView
            android:id="@+id/tvStudentPhone"
            style="@style/TextAppearance.Roomify.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="SĐT: -" />

        <TextView
            android:id="@+id/tvNote"
            style="@style/TextAppearance.Roomify.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Lời nhắn: ..."
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvLandlordNote"
            style="@style/TextAppearance.Roomify.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@color/surface_light"
            android:padding="12dp"
            android:text="Phản hồi của bạn: ..."
            android:visibility="gone" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>