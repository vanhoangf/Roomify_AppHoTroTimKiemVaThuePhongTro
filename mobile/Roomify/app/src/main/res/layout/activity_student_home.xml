<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/studentHomeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg">


    <!-- THANH HEADER -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/homeToolbar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@color/surface_white"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- LOGO KHONG CO TEN -->
        <ImageView
            android:id="@+id/imgHeaderLogo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/roomify_logo"
            android:scaleType="fitCenter"
            android:contentDescription="Logo Roomify"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- TEN UNG DUNG O CHINH GIUA -->
        <TextView
            android:id="@+id/tvHeaderTitle"
            style="@style/TextAppearance.Roomify.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Roomify"
            android:textColor="@color/primary_blue"
            android:textSize="20sp"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- ICON THONG BAO -->
        <ImageButton
            android:id="@+id/btnNotifications"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_dialog_email"
            android:tint="@color/text_muted"
            android:contentDescription="Thông báo"
            android:enabled="false"
            android:alpha="0.5"
            app:layout_constraintEnd_toStartOf="@id/btnLogout"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- ICON DANG XUAT -->
        <ImageButton
            android:id="@+id/btnLogout"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_logout"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:contentDescription="Đăng xuất"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- NOI DUNG CO THE CUON -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/studentHomeScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/homeToolbar"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="32dp">

            <!-- WELCOME -->
            <TextView
                style="@style/TextAppearance.Roomify.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CHÀO MỪNG ĐẾN VỚI ROOMIFY" />

            <TextView
                style="@style/TextAppearance.Roomify.Large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Khám phá phòng trọ phù hợp với bạn" />

            <TextView
                style="@style/TextAppearance.Roomify.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tìm kiếm phòng trọ theo khu vực, mức giá và nhu cầu của bạn." />

            <!-- SEARCH -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:enabled="false"
                app:cardBackgroundColor="@color/surface_white"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/stroke_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_search"
                        android:tint="@color/primary_blue"
                        android:contentDescription="Tìm kiếm" />

                    <TextView
                        style="@style/TextAppearance.Roomify.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="Tìm phòng hoặc địa điểm..."
                        android:textColor="@color/text_muted" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION: ROOMS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.Roomify.Section"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Phòng mới đăng" />

                <!-- MAP -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRoomMap"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:minHeight="44dp"
                    android:text="Bản đồ"
                    android:textAllCaps="false"
                    android:textColor="@color/primary_blue"
                    app:icon="@drawable/ic_map"
                    app:iconGravity="textStart"
                    app:iconSize="18dp"
                    app:iconTint="@color/primary_blue" />

                <!-- SEE ALL -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSeeAllRooms"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:minHeight="44dp"
                    android:text="Xem tất cả"
                    android:textAllCaps="false"
                    android:textColor="@color/primary_blue"
                    android:enabled="false"
                    android:visibility="gone" />

                <!-- MANUAL REFRESH:
                     giữ ID vì Kotlin đang sử dụng,
                     nhưng không hiện trên UI nữa.
                     Home đã có auto refresh 15 giây. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRefreshRooms"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="Làm mới"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- LOADING -->
            <ProgressBar
                android:id="@+id/progressRooms"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvConnectionWarning"
                style="@style/TextAppearance.Roomify.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/surface_light"
                android:padding="12dp"
                android:text="Không thể kết nối máy chủ. Đang hiển thị dữ liệu đã tải trước đó."
                android:textColor="@color/status_error"
                android:visibility="gone" />



            <!-- DANH SACH PHONG - CUON NGANG -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRooms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingEnd="12dp"
                android:scrollbars="none"
                android:visibility="gone" />

            <!-- EMPTY / ERROR STATE -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRoomEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/surface_white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/stroke_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/tvRoomState"
                        style="@style/TextAppearance.Roomify.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Danh sách phòng chưa được tải."
                        android:textColor="@color/text_muted" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRetryRooms"
                        style="@style/Widget.Roomify.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Thử lại"
                        android:visibility="gone" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- INTRO / INFORMATION -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@color/surface_light"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        style="@style/TextAppearance.Roomify.CardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tìm phòng dễ dàng hơn" />

                    <TextView
                        style="@style/TextAppearance.Roomify.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Khám phá thông tin phòng, xem ảnh thực tế do chủ trọ cung cấp và liên hệ khi tìm được phòng phù hợp." />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="68dp"
        android:background="@color/surface_white"
        android:elevation="6dp"

        app:menu="@menu/menu_student_bottom"
        app:labelVisibilityMode="labeled"

        app:itemIconSize="22dp"
        app:itemIconTint="@color/student_nav_tint"
        app:itemTextColor="@color/student_nav_tint"

        app:itemTextAppearanceActive="@style/TextAppearance.Roomify.NavActive"
        app:itemTextAppearanceInactive="@style/TextAppearance.Roomify.NavInactive"
        app:itemActiveIndicatorStyle="@style/Widget.Roomify.StudentNav.ActiveIndicator"

        app:itemPaddingTop="2dp"
        app:itemPaddingBottom="2dp"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>
